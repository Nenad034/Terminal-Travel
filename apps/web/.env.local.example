API_BASE_URL=http://localhost:3000/api/v1
WEB_SESSION_SECRET=change-me-to-a-long-random-string-in-local-dev

# MORA biti ISTA vrednost kao PAYMENT_WEBHOOK_SECRET u apps/api/.env (M10 spec §7.2,
# bezbednosni nalaz 28.8.2026) — koristi se da apps/web potpiše poziv ka
# POST /finance/payments/card/webhook dok mock platni provajder simulira providerov povratni
# poziv (§12 — čeka izbor stvarnog PSP-a, koji donosi sopstvenu šemu potpisa).
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string-in-local-dev
