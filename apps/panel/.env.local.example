API_BASE_URL=http://localhost:3000/api/v1
PANEL_SESSION_SECRET=change-me-to-a-long-random-string-in-local-dev
# M19 spec §3/§8 — koren apps/api hosta (BEZ /api/v1) za direktnu socket.io konekciju iz
# browsera ka WS namespace-u /ws/chat (apps/panel/src/app/(app)/chat/[conversationId]/ChatPanel.tsx).
# NEXT_PUBLIC_ prefiks je namerno klijentski vidljiv (WS host, ne tajna) — sam token dolazi
# odvojeno preko apps/panel/src/app/api/chat/ws-token/route.ts.
NEXT_PUBLIC_API_WS_ORIGIN=http://localhost:3000
