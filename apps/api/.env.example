# Kopirati u .env, popuniti stvarne vrednosti lokalno (.env je u .gitignore).

# Odgovara docker-compose.yml u korenu repozitorijuma.
DATABASE_URL="postgresql://terminal:terminal_dev_only@localhost:5435/terminal?schema=public"

# Generisati nasumičan string (npr. `openssl rand -hex 32`) — potpisuje access/refresh JWT.
JWT_SECRET="promeniti-ovo-u-random-string-pre-bilo-kakve-stvarne-upotrebe"

# Generisati nasumičan string — enkriptuje MFA sekret u mirovanju (M1 spec §3.1).
ENCRYPTION_KEY="promeniti-ovo-u-drugi-random-string"

PORT=3000

# M15 omnisearch (docs/moduli/M15-ai-orkestracija) — Anthropic API ključ za korak 2 (jezički
# model, model claude-haiku-4-5-20251001). Nabaviti na https://console.anthropic.com/settings/keys.
# Ako je prazno, omnisearch i dalje radi (korak 1, direktno poklapanje) samo bez ai_answer objašnjenja.
ANTHROPIC_API_KEY=""

# M21/M23 semantička pretraga nad člancima (pgvector, docker-compose.yml koristi
# pgvector/pgvector:pg16) — OpenAI text-embedding-3-small. Nabaviti na
# https://platform.openai.com/api-keys. Ako je prazno, oba asistenta i dalje rade — padaju na
# postojeći heuristički fallback (poklapanje ključnih reči), isti graceful-degradation princip
# kao ANTHROPIC_API_KEY iznad.
OPENAI_API_KEY=""

# M18 operativni nadzor (docs/moduli/M18-operativni-nadzor, poglavlje 3) — Telegram bot token
# za trenutna CRITICAL/WARNING obaveštenja i nedeljni pregled. Napraviti bota preko @BotFather,
# nabaviti chat_id primaoca (upisuje se po kanalu preko POST /ops/notification-channels, ne ovde).
# Ako je prazno, TelegramClientService ne baca grešku — samo ne šalje (loguje upozorenje).
TELEGRAM_BOT_TOKEN=""

# M18 — email kanal (poglavlje 3) OSTAJE MOCK u ovom prolazu (isti status kao M12
# EmailMockAdapter) — u kodu nema SMTP biblioteke (namerno, CLAUDE.md: nova zavisnost van
# tehničkog steka zahteva potvrdu vlasnika pre uvođenja). Ovaj env var je pripremljen za kad se
# ta odluka donese, EmailClientService ga još ne čita.
# SMTP_HOST=""
