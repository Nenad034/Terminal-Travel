# Kopirati u .env, popuniti stvarne vrednosti lokalno (.env je u .gitignore).

# Odgovara docker-compose.yml u korenu repozitorijuma.
DATABASE_URL="postgresql://terminal:terminal_dev_only@localhost:5435/terminal?schema=public"

# Generisati nasumičan string (npr. `openssl rand -hex 32`) — potpisuje access/refresh JWT.
JWT_SECRET="promeniti-ovo-u-random-string-pre-bilo-kakve-stvarne-upotrebe"

# Generisati nasumičan string — enkriptuje MFA sekret u mirovanju (M1 spec §3.1).
ENCRYPTION_KEY="promeniti-ovo-u-drugi-random-string"

# Generisati nasumičan string (npr. `openssl rand -hex 32`) — deljena tajna za potpisivanje
# POST /finance/payments/card/webhook (M10 spec §7.2, bezbednosni nalaz 28.8.2026). MORA biti
# ISTA vrednost kao PAYMENT_WEBHOOK_SECRET u apps/web/.env.local (jedini pozivalac dok mock
# platni provajder simulira providerov povratni poziv, §12 — čeka izbor stvarnog PSP-a).
PAYMENT_WEBHOOK_SECRET="promeniti-ovo-u-treci-random-string"

PORT=3000

# M15 omnisearch (docs/moduli/M15-ai-orkestracija) — Anthropic API ključ za korak 2 (jezički
# model, model claude-haiku-4-5-20251001). Nabaviti na https://console.anthropic.com/settings/keys.
# Ako je prazno, omnisearch i dalje radi (korak 1, direktno poklapanje) samo bez ai_answer objašnjenja.
ANTHROPIC_API_KEY=""

# M21/M23 semantička pretraga nad člancima (pgvector, docker-compose.yml koristi
# pgvector/pgvector:pg16) — Google Gemini gemini-embedding-2 (1536 dimenzija, poklapa
# vector(1536) kolonu). Nabaviti na https://aistudio.google.com/apikey. Ako je prazno, oba
# asistenta i dalje rade — padaju na postojeći heuristički fallback (poklapanje ključnih reči),
# isti graceful-degradation princip kao ANTHROPIC_API_KEY iznad.
GEMINI_API_KEY=""

# M18 operativni nadzor (docs/moduli/M18-operativni-nadzor, poglavlje 3) — Telegram bot token
# za trenutna CRITICAL/WARNING obaveštenja i nedeljni pregled. Napraviti bota preko @BotFather,
# nabaviti chat_id primaoca (upisuje se po kanalu preko POST /ops/notification-channels, ne ovde).
# Ako je prazno, TelegramClientService ne baca grešku — samo ne šalje (loguje upozorenje).
TELEGRAM_BOT_TOKEN=""

# M18 — email kanal (poglavlje 3). Od 4.9.2026 NIJE mock: EmailClientService delegira
# zajedničkom MailerService-u, koji čita SMTP podešavanja ispod. Bez njih se ponaša kao ranije
# (loguje, ne šalje) — uzbuna o kvaru ne sme da postane drugi kvar.
SMTP_HOST=""

# Slanje sistemske pošte (M1 pozivnica i reset lozinke, M18 uzbune) — dopuna 4.9.2026.
# Aplikacija govori običan SMTP, pa isti podaci rade i za mail hosting agencije i za
# Google Workspace/Microsoft 365 i za servise tipa Mailgun/Brevo/Postmark — bira se van koda.
#
# LOKALNI RAZVOJ: docker-compose.yml diže `mailpit` — hvatač pošte koji sve zadržava kod sebe
# (nijedna poruka ne ode napolje). Podesiti ovako i gledati primljeno na http://localhost:8025:
#   SMTP_HOST="localhost"
#   SMTP_PORT=1025
#   MAIL_FROM="Terminal <no-reply@terminal-travel.local>"
#
# Ako SMTP_HOST ostane prazan, ništa ne puca — poruke se samo loguju kao ranije, a link za
# aktivaciju se u panelu i dalje prikazuje za ručno prosleđivanje (M1 spec §5).
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
# true samo za port 465 (TLS od prvog bajta); 587 i 1025 idu na STARTTLS, ostaviti prazno.
SMTP_SECURE=""
MAIL_FROM=""

# Osnova za linkove u porukama (aktivacija naloga, reset lozinke) — adresa PANELA, ne API-ja.
PANEL_BASE_URL="http://localhost:3100"
