# Kopirati u .env, popuniti stvarne vrednosti lokalno (.env je u .gitignore).

# Odgovara docker-compose.yml u korenu repozitorijuma.
DATABASE_URL="postgresql://terminal:terminal_dev_only@localhost:5435/terminal?schema=public"

# Generisati nasumičan string (npr. `openssl rand -hex 32`) — potpisuje access/refresh JWT.
JWT_SECRET="promeniti-ovo-u-random-string-pre-bilo-kakve-stvarne-upotrebe"

# Generisati nasumičan string — enkriptuje MFA sekret u mirovanju (M1 spec §3.1).
ENCRYPTION_KEY="promeniti-ovo-u-drugi-random-string"

PORT=3000
