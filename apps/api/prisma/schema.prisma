// Prisma šema — M1 (Core / Identitet i pristup)
// Izvor: docs/moduli/M01-core-identitet/02-SPECIFIKACIJA-M1-CORE-IDENTITET.md, poglavlje 3
// Ne dodavati polja/entitete bez oslonca u toj specifikaciji (CLAUDE.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// §3.1 `User` — nalog za prijavu
model User {
  id                  String      @id @default(uuid())
  email               String      @unique
  passwordHash        String?     @map("password_hash") // null dok je status = INVITED (§5 — lozinka se postavlja preko linka)
  fullName            String      @map("full_name")
  phone               String?
  accountType         AccountType @map("account_type")
  linkedProfileId     String?     @map("linked_profile_id")
  status              UserStatus  @default(INVITED)
  mfaEnabled          Boolean     @default(false) @map("mfa_enabled")
  mfaSecretEncrypted  String?     @map("mfa_secret_encrypted")
  failedLoginAttempts Int         @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?   @map("locked_until")
  lastLoginAt         DateTime?   @map("last_login_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  roles               UserRole[]
  permissionOverrides UserPermissionOverride[] @relation("OverrideSubject")
  grantedOverrides    UserPermissionOverride[] @relation("OverrideGrantedBy")
  refreshTokens       RefreshToken[]
  mfaRecoveryCodes    MfaRecoveryCode[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// account_type §3.1 — dodavano kako su moduli dolazili na red (M15 Faza 7, M19 dopuna avgust 2026)
enum AccountType {
  STAFF
  GUEST
  SUBAGENT_CONTACT
  AI_AGENT
  SUPPLIER_CONTACT
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

// §3.2 `Role` — uloga
model Role {
  id           String  @id @default(uuid())
  name         String  @unique
  description  String
  isSystemRole Boolean @default(true) @map("is_system_role")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

// §3.3 `Permission` — katalog mogućih dozvola (svaki modul registruje svoje kad dođe na red)
model Permission {
  id          String @id @default(uuid())
  module      String
  resource    String
  action      String
  description String

  rolePermissions         RolePermission[]
  userPermissionOverrides UserPermissionOverride[]

  @@unique([module, resource, action])
  @@map("permissions")
}

// §3.4 `RolePermission` — podrazumevana prava po ulozi (uvek ALLOW)
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// §3.5 `UserRole` — dodela uloge korisniku
model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedBy String   @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// §3.6 `UserPermissionOverride` — pojedinačni izuzetak (srž traženog "do nivoa stavke")
model UserPermissionOverride {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  permissionId String           @map("permission_id")
  effect       PermissionEffect
  reason       String
  grantedBy    String           @map("granted_by")
  grantedAt    DateTime         @default(now()) @map("granted_at")
  expiresAt    DateTime?        @map("expires_at")

  user          User       @relation("OverrideSubject", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser User       @relation("OverrideGrantedBy", fields: [grantedBy], references: [id])
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@map("user_permission_overrides")
}

enum PermissionEffect {
  ALLOW
  DENY
}

// §3.7 `RefreshToken` (sesija)
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// §5 — 10 jednokratnih rezervnih kodova pri uključivanju 2FA (hešovani)
model MfaRecoveryCode {
  id       String    @id @default(uuid())
  userId   String    @map("user_id")
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_recovery_codes")
}

// §5 — "Zaboravljena lozinka: token sa rokom od 1h, poslat na email, jednokratan."
// Entitet nije poimenično nabrojan u §3, ali ponašanje jeste — isti obrazac heša
// kao RefreshToken/MfaRecoveryCode (čuva se heš, ne sirov token).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// §3.8 `AuditLogEntry` — append-only (sprovedeno na nivou DB role, vidi migraciju)
model AuditLogEntry {
  id           String    @id @default(uuid())
  timestamp    DateTime  @default(now())
  actorType    ActorType @map("actor_type")
  actorId      String?   @map("actor_id")
  module       String
  action       String
  resourceType String    @map("resource_type")
  resourceId   String    @map("resource_id")
  beforeState  Json?     @map("before_state")
  afterState   Json?     @map("after_state")
  context      Json
  ipAddress    String?   @map("ip_address")

  @@map("audit_log_entries")
}

enum ActorType {
  HUMAN
  AI_AGENT
  SYSTEM
}

// ============================================================================
// M2 — Katalog proizvoda
// Izvor: docs/moduli/M02-katalog-proizvoda/03-SPECIFIKACIJA-M2-KATALOG-PROIZVODA.md
// ============================================================================

// §2.1 `Product` — jezički nezavisno jezgro
model Product {
  id                 String            @id @default(uuid())
  type               ProductType
  sourceType         ProductSourceType @map("source_type")
  sourceContractId   String?           @map("source_contract_id") // §2.1 — FK ka M3 Contract; prava relacija otkad M3 postoji (M3 spec §3, izlazni kriterijum)
  sourceProvider     String?           @map("source_provider")
  sourceExternalId   String?           @map("source_external_id")
  destinationCountry String            @map("destination_country")
  destinationCity    String            @map("destination_city")
  geoLat             Decimal?          @map("geo_lat")
  geoLng             Decimal?          @map("geo_lng")
  media              Json              @default("[]") // §2.3a — niz strukturiranih stavki galerije
  attributes         Json              @default("{}") // §2.3 — konvencija po tipu proizvoda
  status             ProductStatus     @default(DRAFT)
  visibleChannels    VisibleChannel[]  @map("visible_channels")
  cacheStatus        CacheStatus       @default(N_A) @map("cache_status")
  lastSyncedAt       DateTime?         @map("last_synced_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  createdBy          String?           @map("created_by") // referencira M1 User ili AI agenta — plain UUID, bez FK (§2.1)

  sourceContract    Contract?              @relation(fields: [sourceContractId], references: [id])
  translations      ProductTranslation[]
  contentImports    ProductContentImport[]
  pricelistMatches  PricelistImportRow[] // M3 §4.2.2 — kandidati mapiranja iz uvoza cenovnika
  // M5 spec §3.0.2/§3.2/§4.2 — dopuna avgust 2026, back-relacije ka rezervacijskom toku.
  itinerarySegments ItinerarySegment[]
  quoteItems        QuoteItem[]
  bookingItems      BookingItem[]

  @@map("products")
}

enum ProductType {
  ACCOMMODATION
  PACKAGE
  TRANSFER
  EXCURSION
  FLIGHT
  INSURANCE
  TRANSPORT
  TICKET
  EVENT
}

enum ProductSourceType {
  CONTRACTED
  API
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VisibleChannel {
  B2C_SITE
  B2B_PORTAL
  MOBILE
}

// §2.1 — `cache_status`; N_A (Prisma enum ne dozvoljava "N/A" kao ime vrednosti) mapira se na "N/A" u bazi.
enum CacheStatus {
  N_A        @map("N/A")
  NOT_CACHED
  CACHED
  STALE
}

// §2.2 `ProductTranslation` — jezički zavisan sadržaj, redovi po jeziku
model ProductTranslation {
  id                String            @id @default(uuid())
  productId         String            @map("product_id")
  languageCode      LanguageCode      @map("language_code")
  name              String
  description       String
  slug              String
  translationSource TranslationSource @default(MANUAL) @map("translation_source")
  isReviewed        Boolean           @default(false) @map("is_reviewed")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, languageCode])
  @@unique([languageCode, slug])
  @@map("product_translations")
}

enum LanguageCode {
  sr
  en
  hr
  sl
  es
  de
  ru
  fr
}

enum TranslationSource {
  MANUAL
  AI_GENERATED
}

// §3.3 `ProductContentImport` — AI-potpomognut uvoz sadržaja sa sajta hotela (CONTRACTED)
model ProductContentImport {
  id            String       @id @default(uuid())
  productId     String?      @map("product_id")
  sourceUrl     String?      @map("source_url") // nullable — §3.3a M23_RESEARCH nema URL, ekstrakcija već urađena
  origin        ImportOrigin @default(MANUAL_URL)
  status        ImportStatus @default(PENDING)
  extractedAt   DateTime?    @map("extracted_at")
  failureReason String?      @map("failure_reason")
  createdBy     String?      @map("created_by") // M1 User ili M23 agent — plain UUID, bez FK
  createdAt     DateTime     @default(now()) @map("created_at")

  product Product?                    @relation(fields: [productId], references: [id], onDelete: SetNull)
  fields  ProductContentImportField[]

  @@map("product_content_imports")
}

enum ImportOrigin {
  MANUAL_URL
  M23_RESEARCH
}

enum ImportStatus {
  PENDING
  EXTRACTED
  REVIEW_IN_PROGRESS
  COMPLETED
  FAILED
}

// §3.3 `ProductContentImportField` — jedna stavka po izvučenom podatku
model ProductContentImportField {
  id                      String          @id @default(uuid())
  importId                String          @map("import_id")
  fieldType               ImportFieldType @map("field_type")
  extractedValue          Json            @map("extracted_value")
  matchConfidence         Decimal?        @map("match_confidence")
  reviewStatus            ReviewStatus    @default(PENDING) @map("review_status")
  reviewedBy              String?         @map("reviewed_by") // M1 User — nikad AI agent (§3.3)
  reviewedAt              DateTime?       @map("reviewed_at")
  appliedAt               DateTime?       @map("applied_at")
  // §3.3a — FK ka M23 ArticleRevision; M23 nije implementiran, plain UUID bez relacije (isti obrazac kao Product.sourceContractId)
  sourceArticleRevisionId String?         @map("source_article_revision_id")

  import ProductContentImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@map("product_content_import_fields")
}

enum ImportFieldType {
  NAME
  DESCRIPTION
  AMENITY
  ROOM_TYPE
  PHOTO
  LOCATION
  SERVICE
}

enum ReviewStatus {
  PENDING
  APPROVED
  EDITED_AND_APPROVED
  REJECTED
}

// ============================================================================
// M3 — Ugovaranje i alotmani
// Izvor: docs/moduli/M03-ugovaranje-alotmani/04-SPECIFIKACIJA-M3-UGOVARANJE-ALOTMANI.md
// Konvencija (poglavlje 2): sve novčane vrednosti su Int u najmanjoj jedinici valute
// (RSD→para, EUR→cent), nikad Decimal/float.
// ============================================================================

// §2.1 `Supplier` — dobavljač
model Supplier {
  id                 String         @id @default(uuid())
  name               String
  type               SupplierType
  taxId              String         @map("tax_id")
  registrationNumber String         @map("registration_number")
  country            String
  contactName        String         @map("contact_name")
  contactEmail       String         @map("contact_email")
  contactPhone       String         @map("contact_phone")
  bankAccount        String?        @map("bank_account")
  status             SupplierStatus @default(ACTIVE)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  contacts               SupplierContact[]
  contracts              Contract[]
  imports                PricelistImport[]
  extractionProfile      SupplierExtractionProfile?
  // M5 spec §8 — dopuna avgust 2026, back-relacije ka operativnim listama.
  supplierManifests      SupplierManifest[]
  announcementRules      SupplierAnnouncementRule[]
  // M10 spec §8 — dopuna avgust 2026, back-relacije ka obavezama/uvozu faktura.
  supplierObligations    SupplierObligation[]
  supplierInvoiceImports SupplierInvoiceImport[]

  @@map("suppliers")
}

enum SupplierType {
  HOTEL
  PREVOZNIK
  OSIGURAVAC
  DRUGO
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

// §2.1a `SupplierContact` — kontakt-osoba kod dobavljača (real-time chat portal, M19)
model SupplierContact {
  id           String                @id @default(uuid())
  supplierId   String                @map("supplier_id")
  fullName     String                @map("full_name")
  email        String
  phone        String
  linkedUserId String?               @map("linked_user_id") // FK ka M1 User (account_type=SUPPLIER_CONTACT); plain UUID, popunjeno tek preko M19 toka
  status       SupplierContactStatus @default(ACTIVE)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_contacts")
}

enum SupplierContactStatus {
  ACTIVE
  INACTIVE
}

// §2.2 `Contract` — ugovor
model Contract {
  id                       String           @id @default(uuid())
  supplierId               String           @map("supplier_id")
  contractNumber           String           @map("contract_number")
  currency                 ContractCurrency
  validFrom                DateTime         @map("valid_from")
  validTo                  DateTime         @map("valid_to")
  cancellationTermsSummary String           @map("cancellation_terms_summary")
  documentUrl              String           @map("document_url")
  // M10 spec §8.0/§8.1 dopuna (avgust 2026, otkriveno pri implementaciji) — rok plaćanja
  // dobavljaču u danima od prijema fakture; M10 SupplierObligation.due_date se izvodi odavde.
  // Nullable — kad nije uneto, M10 koristi podrazumevanih 30 dana (uobičajena praksa).
  paymentTermsDays         Int?             @map("payment_terms_days")
  status                   ContractStatus   @default(DRAFT)
  defaultTipNastupanja     TipNastupanja?   @map("default_tip_nastupanja") // §2.2a — obavezno pre ACTIVE
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  createdBy                String?          @map("created_by")

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  periods  ContractPeriod[]
  products Product[] // M2 Product.sourceContractId — proizvod referencira ugovor, ne duplira cenu (M3 spec §3)

  @@map("contracts")
}

enum ContractCurrency {
  EUR
  RSD
  USD
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum TipNastupanja {
  ORGANIZATOR
  POSREDNIK
}

// §2.3 `ContractPeriod` — sezona/period unutar ugovora
model ContractPeriod {
  id                      String        @id @default(uuid())
  contractId              String        @map("contract_id")
  stayFrom                DateTime      @map("stay_from")
  stayTo                  DateTime      @map("stay_to")
  roomType                String        @map("room_type") // konvencija ka M2 attributes.room_types[].code, ne strogi FK
  allotmentMode           AllotmentMode @map("allotment_mode")
  totalCapacity           Int?          @map("total_capacity")
  unitsSold               Int           @default(0) @map("units_sold")
  releaseDaysBefore       Int?          @map("release_days_before") // samo FIXED
  ukupnaFiksnaObaveza     Int?          @map("ukupna_fiksna_obaveza") // samo CHARTER/FIXED_LEASE
  fixedObligationCurrency String?       @map("fixed_obligation_currency")
  paymentSchedule         Json?         @map("payment_schedule") // samo FIXED_LEASE — niz {due_date, amount}
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  contract          Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  rateLines         RateLine[]
  cancellationRules CancellationRule[]
  // M5 spec §8.1 — dopuna avgust 2026, back-relacija ka operativnim listama.
  supplierManifests SupplierManifest[]

  @@map("contract_periods")
}

enum AllotmentMode {
  FIXED
  ON_REQUEST
  CHARTER
  FIXED_LEASE
}

// §2.4 `RateLine` — cena po kombinaciji unutar perioda
model RateLine {
  id               String     @id @default(uuid())
  contractPeriodId String     @map("contract_period_id")
  boardType        String     @map("board_type")
  occupancy        String
  priceBasis       PriceBasis @map("price_basis")
  price            Int // najmanja jedinica valute ugovora
  cribFeePerNight  Int?       @map("crib_fee_per_night")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  contractPeriod ContractPeriod       @relation(fields: [contractPeriodId], references: [id], onDelete: Cascade)
  agePricing     RateLineAgePricing[]
  // M5 spec §3.2/§4.2 — dopuna avgust 2026, back-relacije ka rezervacijskom toku.
  quoteItems     QuoteItem[]
  bookingItems   BookingItem[]

  @@map("rate_lines")
}

enum PriceBasis {
  PER_ROOM_PER_NIGHT
  PER_PERSON_PER_NIGHT
}

// §2.4a `age_pricing[]` — cena po uzrasnoj kategoriji gosta
model RateLineAgePricing {
  id               String         @id @default(uuid())
  rateLineId       String         @map("rate_line_id")
  ageCategory      AgeCategory    @map("age_category")
  occupantIndex    Int?           @map("occupant_index")
  minAdultsPresent Int?           @map("min_adults_present")
  pricingMode      AgePricingMode @map("pricing_mode")
  percentage       Decimal? // samo PERCENTAGE_OF_BASE_PRICE
  flatPrice        Int?           @map("flat_price") // samo FLAT_PRICE_PER_NIGHT, najmanja jedinica valute

  rateLine RateLine @relation(fields: [rateLineId], references: [id], onDelete: Cascade)

  @@map("rate_line_age_pricing")
}

enum AgeCategory {
  ADULT
  CHILD
  TEEN
  INFANT
}

enum AgePricingMode {
  PERCENTAGE_OF_BASE_PRICE
  FLAT_PRICE_PER_NIGHT
}

// §2.5 `CancellationRule` — pravila otkazivanja po periodu
model CancellationRule {
  id               String @id @default(uuid())
  contractPeriodId String @map("contract_period_id")
  daysBeforeStay   Int    @map("days_before_stay")
  refundPercentage Int    @map("refund_percentage") // 0-100, NIJE novčani iznos

  contractPeriod ContractPeriod @relation(fields: [contractPeriodId], references: [id], onDelete: Cascade)

  @@map("cancellation_rules")
}

// §4.2.1 `PricelistImport`
model PricelistImport {
  id            String                @id @default(uuid())
  supplierId    String                @map("supplier_id")
  sourceFileUrl String                @map("source_file_url")
  sourceFormat  PricelistSourceFormat @map("source_format")
  status        PricelistImportStatus @default(PROCESSING)
  createdBy     String?               @map("created_by")
  createdAt     DateTime              @default(now()) @map("created_at")

  supplier Supplier             @relation(fields: [supplierId], references: [id])
  rows     PricelistImportRow[]

  @@map("pricelist_imports")
}

enum PricelistSourceFormat {
  PDF
  EXCEL
  WORD
  HTML
  EMAIL
  SCANNED_PDF
}

enum PricelistImportStatus {
  PROCESSING
  READY_FOR_REVIEW
  COMPLETED
  REJECTED
}

// §4.2.2 `PricelistImportRow` — jedan red = jedna kombinacija hotel/soba/usluga/period/cena
model PricelistImportRow {
  id                       String                   @id @default(uuid())
  pricelistImportId        String                   @map("pricelist_import_id")
  extractedHotelName       String                   @map("extracted_hotel_name")
  matchedProductId         String?                  @map("matched_product_id")
  matchConfidence          Decimal?                 @map("match_confidence")
  extractedRoomType        String                   @map("extracted_room_type")
  extractedBoardType       String                   @map("extracted_board_type")
  extractedOccupancy       String                   @map("extracted_occupancy") // dopuna, nedostajalo u v1.7 spec-a — kandidat za RateLine.occupancy (§2.4), isti obrazac kao susedna extracted_* polja
  extractedStayFrom        DateTime                 @map("extracted_stay_from")
  extractedStayTo          DateTime                 @map("extracted_stay_to")
  extractedPrice           Int                      @map("extracted_price")
  extractedCurrency        String                   @map("extracted_currency")
  extractedPriceBasis      PriceBasis?              @map("extracted_price_basis")
  extractedAgePricing      Json?                    @map("extracted_age_pricing")
  extractedCribFeePerNight Int?                     @map("extracted_crib_fee_per_night")
  reviewStatus             PricelistRowReviewStatus @default(PENDING) @map("review_status")
  reviewedBy               String?                  @map("reviewed_by")

  import         PricelistImport @relation(fields: [pricelistImportId], references: [id], onDelete: Cascade)
  matchedProduct Product?        @relation(fields: [matchedProductId], references: [id])

  @@map("pricelist_import_rows")
}

enum PricelistRowReviewStatus {
  PENDING
  CONFIRMED
  MANUALLY_MATCHED
  REJECTED
}

// §4.2.5 `SupplierExtractionProfile` — nauči jednom po dobavljaču, koristi ponovo
model SupplierExtractionProfile {
  id                    String      @id @default(uuid())
  supplierId            String      @unique @map("supplier_id")
  typicalPriceBasis     PriceBasis? @map("typical_price_basis")
  typicalAgeThresholds  Json?       @map("typical_age_thresholds")
  structureSignature    Json?       @map("structure_signature")
  lastConfirmedImportId String?     @map("last_confirmed_import_id")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_extraction_profiles")
}

// ============================================================================
// M4 — Integracije spoljnih API konekcija
// Izvor: docs/moduli/M04-integracije-api/05-SPECIFIKACIJA-M4-INTEGRACIJE-API.md
// ============================================================================

// §3.1 `ProviderConfig`
model ProviderConfig {
  id                         String               @id @default(uuid())
  providerCode               String               @unique @map("provider_code")
  displayName                String               @map("display_name")
  category                   ProviderCategory
  authConfigEncrypted        String               @map("auth_config_encrypted")
  authStrategy               ProviderAuthStrategy @map("auth_strategy")
  capabilitiesProfile        Json                 @default("{}") @map("capabilities_profile")
  status                     ProviderStatus       @default(INACTIVE)
  timeoutSearchMs            Int                  @map("timeout_search_ms")
  timeoutBookingMs           Int                  @map("timeout_booking_ms")
  circuitState               CircuitState         @default(CLOSED) @map("circuit_state")
  circuitFailureThreshold    Int                  @default(5) @map("circuit_failure_threshold")
  circuitCooldownSeconds     Int                  @default(60) @map("circuit_cooldown_seconds")
  // §4.1 — brojač uzastopnih grešaka i trenutak otvaranja kola; nisu poimenično u §3.1
  // tabeli ali su neophodni da se pravilo iz §4.1 stvarno sprovede (kad brojati, kad
  // isteknje cooldown).
  circuitConsecutiveFailures Int                  @default(0) @map("circuit_consecutive_failures")
  circuitOpenedAt            DateTime?            @map("circuit_opened_at")
  defaultTipNastupanja       TipNastupanja?       @map("default_tip_nastupanja")
  // §9 — "vredi formalizovati ProviderConfig.use_mock po uzoru na PrimeTravel obrazac".
  // Kad je true, ProviderRegistryService bira MockProviderAdapter umesto pravog
  // adaptera (Travelgate/Solvex) — omogućava testiranje circuit breaker/idempotency/
  // degradacije bez gađanja pravog spoljnog servera.
  useMock                    Boolean              @default(false) @map("use_mock")
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")

  callLogs ProviderCallLog[]

  @@map("provider_configs")
}

enum ProviderCategory {
  HOTEL
  FLIGHT
  TRANSFER
  ACTIVITY
  INSURANCE
}

enum ProviderAuthStrategy {
  API_KEY
  BASIC
  OAUTH2_CLIENT_CREDENTIALS
  REQUEST_SIGNING
  SESSION_TOKEN
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
}

enum CircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

// §3.2 `ProviderCallLog` — operativni log (odvojeno od M1 audit loga)
model ProviderCallLog {
  id             String                 @id @default(uuid())
  providerCode   String                 @map("provider_code")
  operation      ProviderCallOperation
  requestSummary Json                   @map("request_summary")
  responseStatus String                 @map("response_status")
  errorCode      ProviderCallErrorCode? @map("error_code")
  latencyMs      Int                    @map("latency_ms")
  errorMessage   String?                @map("error_message")
  // §4 — "idempotency_key (generisan u M5 po pokušaju rezervacije)"; samo za BOOK.
  idempotencyKey String?                @map("idempotency_key")
  // §4 — "M4 prvo proverava ProviderCallLog da li je taj idempotency_key već poslat i sa
  // kojim ishodom" — mora postojati mesto da se taj ishod (BookingConfirmation) stvarno
  // sačuva da bi se mogao vratiti bez ponovnog poziva; nije poimenično u §3.2 tabeli, ali
  // je neophodno da bi se §4 pravilo o idempotentnosti stvarno moglo sprovesti.
  responseBody   Json?                  @map("response_body")
  timestamp      DateTime               @default(now())

  provider ProviderConfig @relation(fields: [providerCode], references: [providerCode])

  @@map("provider_call_logs")
}

enum ProviderCallOperation {
  SEARCH
  CONTENT
  AVAILABILITY
  BOOK
  CANCEL
}

enum ProviderCallErrorCode {
  TIMEOUT
  RATE_LIMITED
  AUTH_FAILED
  INVALID_REQUEST
  NO_AVAILABILITY
  PROVIDER_UNAVAILABLE
  UNKNOWN
}

// ============================================================================
// M5 — Rezervacije i tok prodaje (JEZGRO — poglavlja 2, 3.0-3.2b, 4-4.0a, 5, 6-6.4, 7, 9, 10, 11)
// Izvor: docs/moduli/M05-rezervacije/06-SPECIFIKACIJA-M5-REZERVACIJE.md
// Poglavlje 8 (operativne liste za dobavljače: SupplierManifest/SupplierChangeNotice/
// SupplierAnnouncementRule) je NAMERNO izostavljeno — odvojen, kasniji zadatak (delimično
// zavisi od M22). Konvencija (poglavlje 2): sve novčane vrednosti su Int u najmanjoj
// jedinici valute, nikad Decimal/float.
// ============================================================================

enum M5Channel {
  B2C_SITE
  B2B_PORTAL
  MOBILE
  INTERNAL_PANEL
  PHONE
}

// §2.1 `MarkupRule`
model MarkupRule {
  id                  String          @id @default(uuid())
  scopeType           MarkupScopeType @map("scope_type")
  scopeId             String          @map("scope_id") // polimorfno — cilja različite tabele zavisno od scopeType, namerno bez FK (§2.1)
  percentage          Decimal?
  fixedAmount         Int?            @map("fixed_amount")
  fixedAmountCurrency String?         @map("fixed_amount_currency")
  activeFrom          DateTime?       @map("active_from")
  activeTo            DateTime?       @map("active_to")
  createdBy           String?         @map("created_by")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  quoteItems   QuoteItem[]
  bookingItems BookingItem[]

  @@map("markup_rules")
}

enum MarkupScopeType {
  M3_SUPPLIER
  M3_CONTRACT
  M3_CONTRACT_PERIOD
  M4_PROVIDER
  M2_PRODUCT
}

// §3.0.1 `Itinerary`
model Itinerary {
  id              String          @id @default(uuid())
  clientAccountId String?         @map("client_account_id") // buduće M6 Nalogodavac — nullable, bez FK (M6 ne postoji)
  channel         M5Channel
  status          ItineraryStatus @default(DRAFT)
  title           String?
  createdBy       String?         @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  segments ItinerarySegment[]
  quotes   Quote[]

  @@map("itineraries")
}

enum ItineraryStatus {
  DRAFT
  CONVERTED
  ABANDONED
}

// §3.0.2 `ItinerarySegment`
model ItinerarySegment {
  id                 String    @id @default(uuid())
  itineraryId        String    @map("itinerary_id")
  sequenceOrder      Int       @map("sequence_order")
  productId          String?   @map("product_id")
  destinationCountry String?   @map("destination_country")
  destinationCity    String?   @map("destination_city")
  stayFrom           DateTime? @map("stay_from")
  stayTo             DateTime? @map("stay_to")
  notes              String?

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@map("itinerary_segments")
}

// §3.1 `Quote`
model Quote {
  id                      String      @id @default(uuid())
  clientAccountId         String?     @map("client_account_id") // buduće M6 Nalogodavac
  channel                 M5Channel
  status                  QuoteStatus @default(DRAFT)
  expiresAt               DateTime    @map("expires_at")
  itineraryId             String?     @map("itinerary_id")
  contractTermsAccepted   Boolean     @default(false) @map("contract_terms_accepted")
  contractTermsAcceptedAt DateTime?   @map("contract_terms_accepted_at")
  createdBy               String?     @map("created_by")
  referralTrackingCode    String?     @map("referral_tracking_code")
  createdAt               DateTime    @default(now()) @map("created_at")

  itinerary Itinerary?  @relation(fields: [itineraryId], references: [id])
  items     QuoteItem[]
  payments  Payment[]

  @@map("quotes")
}

enum QuoteStatus {
  DRAFT
  EXPIRED
  CONVERTED
}

// §3.2 `QuoteItem`
model QuoteItem {
  id                         String            @id @default(uuid())
  quoteId                    String            @map("quote_id")
  productId                  String            @map("product_id")
  sourceType                 ProductSourceType @map("source_type")
  stayFrom                   DateTime          @map("stay_from")
  stayTo                     DateTime          @map("stay_to")
  occupancy                  Json // §3.2a — {adults, children, room_config[]}
  baseCost                   Int               @map("base_cost")
  baseCostCurrency           String            @map("base_cost_currency")
  rateLineId                 String?           @map("rate_line_id")
  markupRuleId               String            @map("markup_rule_id")
  finalPrice                 Int               @map("final_price")
  finalPriceCurrency         String            @map("final_price_currency")
  providerQuoteReference     String?           @map("provider_quote_reference")
  // §4.2 dopuna (v1.14) — broj rezervisanih jedinica (soba), iz occupancy.room_config.length;
  // potrebno da se pri otkazivanju/izmeni oslobodi TAČAN broj jedinica nazad u M3 (ne uvek 1).
  unitCount                  Int               @default(1) @map("unit_count")
  // §4.2 dopuna (v1.14) — samo za API (M4) stavke: snimak M4 AvailabilityQuote.cancellationPolicy
  // (isti strukturirani oblik kao M3 CancellationRule, §2.1 M4 spec) u trenutku građenja stavke,
  // da bi se procenat povraćaja pri otkazivanju mogao izračunati deterministički, bez ponovnog
  // poziva ka M4 (koji možda više ne vraća istu polisu). Null za CONTRACTED stavke (koriste M3
  // CancellationRule uživo preko rate_line_id, nema potrebe za snimkom).
  cancellationPolicySnapshot Json?             @map("cancellation_policy_snapshot")

  quote      Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
  rateLine   RateLine?  @relation(fields: [rateLineId], references: [id])
  markupRule MarkupRule @relation(fields: [markupRuleId], references: [id])

  @@map("quote_items")
}

// §4.1 `Booking`
model Booking {
  id                        String        @id @default(uuid())
  bookingNumber             String        @unique @map("booking_number")
  clientAccountId           String        @map("client_account_id") // buduće M6 Nalogodavac
  // §4.1 dopuna (v1.17, avgust 2026) — minimalni podaci o kupcu, unose se pri potvrdi rezervacije
  // (ConfirmQuoteDto). Ne čekaju M6 jer su potrebni odmah M10 fiskalizaciji (SEF/ESIR izbor tipa
  // dokumenta, M10 spec §1.1/§2) — kad M6 Nalogodavac zaživi, ova polja mogu postati izvedena iz
  // njega umesto ručnog unosa, ali oblik ostaje isti.
  buyerName                 String        @map("buyer_name")
  buyerType                 BuyerType     @map("buyer_type")
  buyerTaxId                String?       @map("buyer_tax_id") // obavezno kad je buyerType = PRAVNO_LICE (validacija u DTO-u)
  channel                   M5Channel
  tipNastupanja             TipNastupanja @map("tip_nastupanja")
  status                    BookingStatus @default(PENDING_SUPPLIER_CONFIRMATION)
  paymentStatus             PaymentStatus @default(UNPAID) @map("payment_status")
  totalPrice                Int           @map("total_price")
  currency                  String
  voucherUrl                String?       @map("voucher_url")
  voucherOverrideApprovedBy String?       @map("voucher_override_approved_by")
  voucherOverrideReason     String?       @map("voucher_override_reason")
  voucherOverrideAt         DateTime?     @map("voucher_override_at")
  createdAt                 DateTime      @default(now()) @map("created_at")
  confirmedAt               DateTime?     @map("confirmed_at")
  cancelledAt               DateTime?     @map("cancelled_at")
  createdBy                 String        @map("created_by") // user id ili "GOST_SELF"
  referralTrackingCode      String?       @map("referral_tracking_code")
  // M20 spec §3.2 dopuna (avgust 2026) — kopija Quote.contract_terms_accepted_at u trenutku
  // potvrde, kad je samouslužni kanal (M8/M9/M7) već dobio clickwrap pristanak pre potvrde.
  // Ne postoji Booking.quote_id (rezervacija se ne referencira nazad na Ponudu), pa se ovde
  // kopira samo ono što je M20 stvarno potrebno — isti obrazac kao buyer_name/buyer_type dopuna.
  contractTermsAcceptedAt   DateTime?     @map("contract_terms_accepted_at")

  items                       BookingItem[]
  fiscalDocuments             FiscalDocument[]
  payments                    Payment[]
  clientPaymentSchedule       ClientPaymentSchedule?
  travelGuaranteeRegistration TravelGuaranteeRegistration?
  clientContracts             ClientContract[]
  postTripSurvey              PostTripSurvey?

  @@map("bookings")
}

// §4.1 dopuna (v1.17) — ko je kupac: fizičko ili pravno lice (određuje SEF vs ESIR u M10).
enum BuyerType {
  FIZICKO_LICE
  PRAVNO_LICE
}

enum BookingStatus {
  PENDING_SUPPLIER_CONFIRMATION
  CONFIRMED
  MODIFIED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  INVOICE_PENDING
}

// §4.2 `BookingItem`
model BookingItem {
  id                           String            @id @default(uuid())
  bookingId                    String            @map("booking_id")
  productId                    String            @map("product_id")
  sourceType                   ProductSourceType @map("source_type")
  supplierReference            String            @map("supplier_reference")
  stayFrom                     DateTime          @map("stay_from")
  stayTo                       DateTime          @map("stay_to")
  baseCost                     Int               @map("base_cost")
  baseCostCurrency             String            @map("base_cost_currency")
  rateLineId                   String?           @map("rate_line_id")
  markupRuleId                 String            @map("markup_rule_id")
  finalPrice                   Int               @map("final_price")
  finalPriceCurrency           String            @map("final_price_currency")
  itemStatus                   BookingItemStatus @default(CONFIRMED) @map("item_status")
  cancellationRefundPercentage Int?              @map("cancellation_refund_percentage")
  // §4.2 dopuna (v1.14) — vidi QuoteItem.unitCount/cancellationPolicySnapshot iznad, isto obrazloženje;
  // kopira se iz QuoteItem pri potvrdi (§4) i pri izmeni (§6, nova stavka).
  unitCount                    Int               @default(1) @map("unit_count")
  cancellationPolicySnapshot   Json?             @map("cancellation_policy_snapshot")
  assignedGuideId              String?           @map("assigned_guide_id") // FK -> M1 User (VODIC), plain UUID (M9 još ne postoji)
  duplicateConflictItemId      String?           @map("duplicate_conflict_item_id")
  duplicateCheckOverriddenBy   String?           @map("duplicate_check_overridden_by")
  duplicateCheckOverriddenAt   DateTime?         @map("duplicate_check_overridden_at")
  // §8.6 polja — deo modela (§4.2 tabela), ali njihova PUNA logika (SupplierManifest tok)
  // je poglavlje 8, namerno van obima ovog zadatka. Za API stavke se i dalje popunjavaju
  // pri potvrdi (§8.6 "za API stavke: automatski, isti trenutak kao item_status=CONFIRMED").
  announcedAt                  DateTime?         @map("announced_at")
  supplierConfirmedAt          DateTime?         @map("supplier_confirmed_at")
  supplierConfirmedBy          String?           @map("supplier_confirmed_by")

  booking             Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  product             Product                @relation(fields: [productId], references: [id])
  rateLine            RateLine?              @relation(fields: [rateLineId], references: [id])
  markupRule          MarkupRule             @relation(fields: [markupRuleId], references: [id])
  guests              BookingItemGuest[]
  // M5 spec §8 — dopuna avgust 2026, back-relacije ka operativnim listama.
  manifestEntries     SupplierManifestItem[]
  changeNotices       SupplierChangeNotice[]
  // M10 spec §8 — dopuna avgust 2026, back-relacija ka obavezi prema dobavljaču.
  supplierObligations SupplierObligation[]

  @@map("booking_items")
}

enum BookingItemStatus {
  CONFIRMED
  PENDING_SUPPLIER_CONFIRMATION
  CANCELLED
}

// §4.3 `BookingItemGuest` — spojna tabela; guestProfileId je placeholder ka budućem M6 Gost
// (bez FK, M6 ne postoji). guestFirstName/guestLastName su stub polja NEOPHODNA da provera
// duplikata (§6.4, fuzzy-match po imenu) uopšte može da radi pre nego što M6 GuestProfile
// postoji — kad M6 dođe na red, ova dva polja se povlače iz GuestProfile preko guestProfileId
// i ova dva stub polja se uklanjaju (dokumentovano i u §13 backlogu).
model BookingItemGuest {
  bookingItemId  String  @map("booking_item_id")
  guestProfileId String? @map("guest_profile_id")
  guestFirstName String  @map("guest_first_name")
  guestLastName  String  @map("guest_last_name")

  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@id([bookingItemId, guestFirstName, guestLastName])
  @@map("booking_item_guests")
}

// ============================================================================
// M5 — poglavlje 8 (operativne liste za dobavljače): SupplierManifest/
// SupplierManifestItem/SupplierChangeNotice/SupplierAnnouncementRule.
// Dopunjeno u istom prolazu kad je poglavlje 8 implementirano (bilo je namerno
// izostavljeno u prvom prolazu, vidi napomenu iznad enum M5Channel).
// ============================================================================

enum SupplierManifestStatus {
  DRAFT
  SENT
  SUPERSEDED
}

enum SupplierManifestLanguage {
  SR
  EN
}

// §8.1 `SupplierManifest`
model SupplierManifest {
  id                        String                   @id @default(uuid())
  supplierId                String                   @map("supplier_id")
  contractPeriodId          String?                  @map("contract_period_id")
  supplierTypeSnapshot      SupplierType             @map("supplier_type_snapshot")
  language                  SupplierManifestLanguage @default(SR)
  periodFrom                DateTime                 @map("period_from")
  periodTo                  DateTime                 @map("period_to")
  status                    SupplierManifestStatus   @default(DRAFT)
  documentUrl               String?                  @map("document_url")
  generatedAt               DateTime                 @default(now()) @map("generated_at")
  generatedBy               String                   @map("generated_by") // user id ili "AI_AGENT_M5"
  sentAt                    DateTime?                @map("sent_at")
  sentBy                    String?                  @map("sent_by")
  sentToEmail               String?                  @map("sent_to_email")
  referenceCode             String?                  @unique @map("reference_code")
  confirmationEmailThreadId String?                  @map("confirmation_email_thread_id") // buduće M22 EmailThread, bez FK (M22 ne postoji)
  supersedesManifestId      String?                  @map("supersedes_manifest_id")

  supplier       Supplier               @relation(fields: [supplierId], references: [id])
  contractPeriod ContractPeriod?        @relation(fields: [contractPeriodId], references: [id])
  supersedes     SupplierManifest?      @relation("ManifestSupersedes", fields: [supersedesManifestId], references: [id])
  supersededBy   SupplierManifest[]     @relation("ManifestSupersedes")
  items          SupplierManifestItem[]

  @@map("supplier_manifests")
}

// §8.2 `SupplierManifestItem` — spojna tabela
model SupplierManifestItem {
  supplierManifestId String   @map("supplier_manifest_id")
  bookingItemId      String   @map("booking_item_id")
  includedAt         DateTime @default(now()) @map("included_at")

  supplierManifest SupplierManifest @relation(fields: [supplierManifestId], references: [id], onDelete: Cascade)
  bookingItem      BookingItem      @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@id([supplierManifestId, bookingItemId])
  @@map("supplier_manifest_items")
}

enum SupplierChangeNoticeType {
  MODIFICATION
  CANCELLATION
}

enum SupplierChangeNoticeStatus {
  DRAFT
  SENT
}

// §8.6/§8.8 `SupplierChangeNotice`
model SupplierChangeNotice {
  id                        String                     @id @default(uuid())
  bookingItemId             String                     @map("booking_item_id")
  noticeType                SupplierChangeNoticeType   @map("notice_type")
  referenceCode             String                     @unique @map("reference_code")
  status                    SupplierChangeNoticeStatus @default(DRAFT)
  sentAt                    DateTime?                  @map("sent_at")
  sentBy                    String?                    @map("sent_by")
  supplierConfirmedAt       DateTime?                  @map("supplier_confirmed_at")
  supplierConfirmedBy       String?                    @map("supplier_confirmed_by")
  confirmationEmailThreadId String?                    @map("confirmation_email_thread_id") // buduće M22 EmailThread
  createdAt                 DateTime                   @default(now()) @map("created_at")

  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@map("supplier_change_notices")
}

enum AnnouncementTriggerCondition {
  DAYS_BEFORE_STAY
  ON_CONFIRMATION
  AFTER_DEPOSIT_PAID
  AFTER_FULL_PAYMENT
}

// §8.7 `SupplierAnnouncementRule`
model SupplierAnnouncementRule {
  id               String                       @id @default(uuid())
  supplierId       String?                      @map("supplier_id") // NULL = podrazumevano pravilo
  triggerCondition AnnouncementTriggerCondition @map("trigger_condition")
  daysBeforeStay   Int?                         @map("days_before_stay")
  createdBy        String?                      @map("created_by")
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedBy        String?                      @map("updated_by")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@map("supplier_announcement_rules")
}

// ==========================================================================
// M10 — Finansije i računovodstvo
// Izvor: docs/moduli/M10-finansije/07-SPECIFIKACIJA-M10-FINANSIJE.md
// Ne dodavati polja/entitete bez oslonca u toj specifikaciji (CLAUDE.md).
// ==========================================================================

enum ExchangeRateSource {
  NBS_API
  MANUAL
}

// §3.1 `ExchangeRateSnapshot`
model ExchangeRateSnapshot {
  id            String             @id @default(uuid())
  currency      String
  rateDate      DateTime           @map("rate_date")
  nbsMiddleRate Decimal            @map("nbs_middle_rate")
  source        ExchangeRateSource
  createdAt     DateTime           @default(now()) @map("created_at")

  fiscalDocuments      FiscalDocument[]
  obligationsAtInvoice SupplierObligation[] @relation("ObligationInvoiceRate")
  obligationsAtPayment SupplierObligation[] @relation("ObligationPaymentRate")

  @@map("exchange_rate_snapshots")
}

enum FiscalDocumentType {
  SEF_EFAKTURA
  ESIR_RACUN
  KNJIZNO_ODOBRENJE
}

enum FiscalDocumentStatus {
  DRAFT
  SUBMITTED
  ISSUED
  REJECTED
  STORNIRANO
}

enum VatCalculationBasis {
  MARZA
  PROVIZIJA
  PUNA_OSNOVICA
}

// §5.1 — N_A (Prisma enum ne dozvoljava "N/A" kao ime vrednosti) mapira se na "N/A" u bazi,
// isti obrazac kao M2 CacheStatus.
enum BuyerAcceptanceStatus {
  N_A      @map("N/A")
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// §5.1 `FiscalDocument`
model FiscalDocument {
  id                      String                 @id @default(uuid())
  bookingId               String?                @map("booking_id") // nullable — jedini slučaj je KNJIZNO_ODOBRENJE (§5.1a)
  documentType            FiscalDocumentType     @map("document_type")
  status                  FiscalDocumentStatus   @default(DRAFT)
  vatCalculationBasis     VatCalculationBasis?   @map("vat_calculation_basis") // nullable — KNJIZNO_ODOBRENJE (§5.1a) nema booking_id pa nema osnovicu za izvođenje
  stornoOfDocumentId      String?                @map("storno_of_document_id") // §6.1 — popunjeno na storno dokumentu, referencira original
  externalReference       String?                @map("external_reference")
  amountOriginal          Int                    @map("amount_original")
  currencyOriginal        String                 @map("currency_original")
  amountRsd               Int                    @map("amount_rsd")
  vatRate                 Decimal                @map("vat_rate")
  vatAmount               Int                    @map("vat_amount")
  exchangeRateSnapshotId  String?                @map("exchange_rate_snapshot_id")
  buyerNameSnapshot       String                 @map("buyer_name_snapshot")
  buyerTaxIdSnapshot      String?                @map("buyer_tax_id_snapshot")
  buyerAcceptanceStatus   BuyerAcceptanceStatus? @map("buyer_acceptance_status") // samo za SEF_EFAKTURA
  buyerAcceptanceDeadline DateTime?              @map("buyer_acceptance_deadline")
  pdfUrl                  String?                @map("pdf_url")
  xmlUrl                  String?                @map("xml_url")
  submittedBy             String?                @map("submitted_by") // popunjeno tek pri SUBMIT — obavezno ljudski nalog, nikad AI (§6)
  submittedAt             DateTime?              @map("submitted_at")
  issuedAt                DateTime?              @map("issued_at")
  relatedSubagentId       String?                @map("related_subagent_id") // buduće M7 Subagent — samo za KNJIZNO_ODOBRENJE
  creditedRebateId        String?                @map("credited_rebate_id") // buduće M7 CommissionRebate — samo za KNJIZNO_ODOBRENJE
  createdAt               DateTime               @default(now()) @map("created_at")

  booking              Booking?              @relation(fields: [bookingId], references: [id])
  exchangeRateSnapshot ExchangeRateSnapshot? @relation(fields: [exchangeRateSnapshotId], references: [id])
  stornoOf             FiscalDocument?       @relation("FiscalDocumentStorno", fields: [stornoOfDocumentId], references: [id])
  stornoDocuments      FiscalDocument[]      @relation("FiscalDocumentStorno")

  @@map("fiscal_documents")
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
}

// §5.2 — različito ime od M5 PaymentStatus (Booking.payment_status) — ovo je status pojedinačne uplate.
enum PaymentRecordStatus {
  PENDING
  RECEIVED
  FAILED
  REFUNDED
  VOIDED
}

// §5.2 `Payment`
model Payment {
  id                    String              @id @default(uuid())
  bookingId             String?             @map("booking_id") // nullable — kartično plaćanje prethodi Booking-u (§7.2)
  quoteId               String?             @map("quote_id")
  amount                Int
  currency              String
  method                PaymentMethod
  status                PaymentRecordStatus @default(PENDING)
  reference             String?
  gatewayProvider       String?             @map("gateway_provider") // samo za CARD
  gatewayTransactionId  String?             @map("gateway_transaction_id") // samo za CARD
  gatewayIdempotencyKey String?             @unique @map("gateway_idempotency_key") // samo za CARD
  receivedAt            DateTime?           @map("received_at")
  recordedBy            String?             @map("recorded_by") // null za CARD (webhook beleži automatski)
  createdAt             DateTime            @default(now()) @map("created_at")

  booking            Booking?            @relation(fields: [bookingId], references: [id])
  quote              Quote?              @relation(fields: [quoteId], references: [id])
  refundInstructions RefundInstruction[]

  @@map("payments")
}

// §5.4.1 `PaymentTermsConfig` — singleton (sistem uvek čita najnoviji updated_at)
model PaymentTermsConfig {
