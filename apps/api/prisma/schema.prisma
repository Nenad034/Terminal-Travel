  escalationDaysAfterDue          Int      @map("escalation_days_after_due")
  updatedBy                       String   @map("updated_by")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  @@map("payment_terms_configs")
}

enum PaymentScheduleStatus {
  PENDING
  MET
  OVERDUE
}

// §5.4.2 `ClientPaymentSchedule` — vrednosti snimljene iz PaymentTermsConfig u trenutku kreiranja (§5.4.2)
model ClientPaymentSchedule {
  id             String                @id @default(uuid())
  bookingId      String                @unique @map("booking_id")
  depositAmount  Int                   @map("deposit_amount")
  depositDueDate DateTime              @map("deposit_due_date")
