  @@map("post_trip_surveys")
}

// ============================================================================
// M7 — B2B modul (Subagenti). docs/moduli/M07-b2b-subagenti/12-SPECIFIKACIJA-M7-B2B-SUBAGENTI.md
// Implementacija avgust 2026 pokriva §2.1, §3, §3.1, §3.2, §4, §5, §6, §8, §9, §10 — §2.0.3
// (omnisearch) i §2.0.4 (AI chat, SubagentBookingRequest/SubagentChatMessage) NAMERNO izostavljeni
// (zavise od M15, koji još ne postoji kao NestJS modul — vidi tt-m7-b2b-subagenti skill).
// ============================================================================

enum SubagentStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

// §2.1 `Subagent` — client_account_id NAMERNO bez FK ka ClientAccount, isti razlog kao svako drugo
// polje koje referencira M6 ClientAccount.id u ovoj šemi (ClientLoyaltyStatus/CommunicationLog/
// PostTripSurvey iznad, ClientContract §6 dopuna) — aplikativni nivo je jedini koji sprovodi
// postojanje/tip naloga (M7 spec §2.1 "mora biti account_type = LEGAL_ENTITY"), ne baza.
// current_outstanding_balance se NAMERNO ne čuva ovde — računa se uživo (§2.1) preko
// SubagentsService.outstandingBalance, isti princip kao M6 istorija putovanja.
// commission_percentage/credit_limit(_currency) su NAMERNO nullable — mehanička dopuna (avgust
// 2026): §9 kaže da Vlasnik/Direktor "postavlja kreditni limit i, ako je Tier 1, proviziju" TEK
// pri odobravanju (approve()), pa novoregistrovan PENDING_APPROVAL subagent ta polja još nema.
model Subagent {
  id                   String         @id @default(uuid())
  clientAccountId      String         @unique @map("client_account_id")
  parentSubagentId     String?        @map("parent_subagent_id")
  status               SubagentStatus @default(PENDING_APPROVAL)
  commissionPercentage Decimal?       @map("commission_percentage")
  creditLimit          Decimal?       @map("credit_limit")
  creditLimitCurrency  String?        @map("credit_limit_currency")
  approvedBy           String?        @map("approved_by")
  approvedAt           DateTime?      @map("approved_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  parent   Subagent?  @relation("SubagentHierarchy", fields: [parentSubagentId], references: [id])
  children Subagent[] @relation("SubagentHierarchy")

  volumeTiers  CommissionVolumeTier[]
  volumeStatus SubagentVolumeStatus?
  rebates      CommissionRebate[]

  @@map("subagents")
}

enum CommissionVolumeMetric {
  TOTAL_SALES_RSD
  BOOKING_COUNT
  NIGHT_COUNT
}

enum CommissionVolumePeriod {
  CALENDAR_QUARTER
  CALENDAR_YEAR
  ROLLING_12_MONTHS
}

// §3.1 `CommissionVolumeTier` — pragovi su specifični po subagentskom odnosu (ne globalni,
// za razliku od M6 LoyaltyTier), jer su B2B ugovori pojedinačno pregovarani.
model CommissionVolumeTier {
  id                             String                 @id @default(uuid())
  subagentId                     String                 @map("subagent_id")
  rank                           Int
  thresholdMetric                CommissionVolumeMetric @map("threshold_metric")
  thresholdPeriod                CommissionVolumePeriod @map("threshold_period")
  thresholdValue                 Decimal                @map("threshold_value")
  resultingCommissionPercentage  Decimal?               @map("resulting_commission_percentage")
  resultingCommissionFixedAmount Decimal?               @map("resulting_commission_fixed_amount")
  resultingCommissionCurrency    String?                @map("resulting_commission_currency")
  retroactive                    Boolean                @default(false)
  createdBy                      String?                @map("created_by")
  createdAt                      DateTime               @default(now()) @map("created_at")

  subagent             Subagent               @relation(fields: [subagentId], references: [id])
  currentForStatuses   SubagentVolumeStatus[]
  triggeringForRebates CommissionRebate[]

  @@map("commission_volume_tiers")
}

// §3.1 `SubagentVolumeStatus` — automatski preračun na booking.confirmed/booking.cancelled
// (M5 Event Bus), isti obrazac kao M6 ClientLoyaltyStatus.
model SubagentVolumeStatus {
  id                            String    @id @default(uuid())
  subagentId                    String    @unique @map("subagent_id")
  calculatedMetricValue         Decimal   @default(0) @map("calculated_metric_value")
  currentTierId                 String?   @map("current_tier_id")
  effectiveCommissionPercentage Decimal   @map("effective_commission_percentage")
  periodStart                   DateTime  @map("period_start")
  periodEnd                     DateTime  @map("period_end")
  lastRecalculatedAt            DateTime? @map("last_recalculated_at")

  subagent    Subagent              @relation(fields: [subagentId], references: [id])
  currentTier CommissionVolumeTier? @relation(fields: [currentTierId], references: [id])

  @@map("subagent_volume_statuses")
}

enum CommissionRebateStatus {
  DRAFT
  APPROVED
  APPLIED
  REJECTED
}

// §3.2 `CommissionRebate` — poseban jednokratan rabat, NE ponovno otvaranje/storniranje već
// poslatih fiskalnih dokumenata (M10). rejection_reason namerno nije kolona (spec §3.2 tabela je
// ne navodi) — razlog odbijanja se upisuje u audit log context, isti obrazac kao svaka druga
// APPROVE/REJECT odluka bez sopstvenog polja u ovom modulu.
model CommissionRebate {
  id               String                 @id @default(uuid())
  subagentId       String                 @map("subagent_id")
  triggeringTierId String                 @map("triggering_tier_id")
  periodStart      DateTime               @map("period_start")
  periodEnd        DateTime               @map("period_end")
  calculatedAmount Decimal                @map("calculated_amount")
  currency         String
  status           CommissionRebateStatus @default(DRAFT)
  approvedBy       String?                @map("approved_by")
  approvedAt       DateTime?              @map("approved_at")
  appliedAt        DateTime?              @map("applied_at")
  createdAt        DateTime               @default(now()) @map("created_at")

  subagent       Subagent             @relation(fields: [subagentId], references: [id])
  triggeringTier CommissionVolumeTier @relation(fields: [triggeringTierId], references: [id])

  @@map("commission_rebates")
}

// M14 — Podrška / Helpdesk: docs/moduli/M14-helpdesk/14-SPECIFIKACIJA-M14-HELPDESK.md
// §2.1/§2.2 — requester_client_account_id (M6), related_booking_id (M5), source_email_thread_id
// (M22, modul još ne postoji u kodu) i assigned_to/sent_by (M1 User) su NAMERNO bez DB-nivo FK —
// isti obrazac kao M6/M7/M10/M11/M20 (weak reference, jer ovi moduli već koriste proizvoljne
// placeholder ID-jeve u e2e fixtures — vidi napomenu iznad ClientAccountType).

enum TicketRequesterType {
  GUEST
  SUBAGENT
  STAFF_ON_BEHALF
}

enum TicketCategory {
  REZERVACIJA
  PLACANJE
  TEHNICKI_PROBLEM
  REKLAMACIJA
  DRUGO
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// §2.1 — HELP_CENTER dodato pri specifikaciji M21 (eskalacija iz AI asistenta).
enum TicketChannel {
  SITE_FORM
  B2B_PORTAL
  EMAIL
  PHONE
  HELP_CENTER
}

// §2.1 `Ticket`
model Ticket {
  id                       String              @id @default(uuid())
  ticketNumber             String              @unique @map("ticket_number")
  requesterClientAccountId String?             @map("requester_client_account_id") // weak ref → M6 ClientAccount
  requesterType            TicketRequesterType @map("requester_type")
  relatedBookingId         String?             @map("related_booking_id") // weak ref → M5 Booking
  subject                  String
  category                 TicketCategory
  priority                 TicketPriority      @default(NORMAL)
  status                   TicketStatus        @default(OPEN)
  channel                  TicketChannel
  sourceEmailThreadId      String?             @map("source_email_thread_id") // weak ref → M22 EmailThread, popunjeno preko EmailTicketConversionService
  assignedTo               String?             @map("assigned_to") // weak ref → M1 User, isti obrazac kao CommunicationLog.sent_by
  zzpResponseDeadline      DateTime?           @map("zzp_response_deadline") // §3.1 — samo REKLAMACIJA, created_at + 8 dana
  zzpEscalatedAt           DateTime?           @map("zzp_escalated_at") // §3.1 — popunjeno ako 5 dana bez STAFF odgovora
  refundDecision           Boolean             @default(false) @map("refund_decision") // §3.2/§8 dopuna — vidi PATCH /tickets/:id
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  resolvedAt               DateTime?           @map("resolved_at")

  messages TicketMessage[]

  @@map("tickets")
}

enum TicketMessageSenderType {
  REQUESTER
  STAFF
  AI_DRAFT
}

// §2.2 `TicketMessage`
model TicketMessage {
  id             String                  @id @default(uuid())
  ticketId       String                  @map("ticket_id")
  senderType     TicketMessageSenderType @map("sender_type")
  senderId       String?                 @map("sender_id") // M1 User ili M6 ClientAccount/GuestProfile, weak ref
  body           String
  isInternalNote Boolean                 @default(false) @map("is_internal_note")
  sentBy         String?                 @map("sent_by") // weak ref → M1 User — popunjeno tek pri stvarnom slanju (§4)
  createdAt      DateTime                @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@map("ticket_messages")
}

// ============================================================================
// M13 — Izveštavanje i BI (docs/moduli/M13-bi/13-SPECIFIKACIJA-M13-BI.md)
// ============================================================================

// §3.1 `FactBooking` — denormalizovana činjenična tabela, IZVEDENA projekcija (poglavlje 1.1):
// obnovljiva u potpunosti iz M2/M3/M5/M6/M7 preko rekonsilijacije, nikad izvor istine. Sva
// polja osim id/last_synced_at su weak reference/snapshot (bez Prisma @relation), isti obrazac
// kao M6/M7/M10/M11/M14/M20. Jedan red po M5 BookingItem (booking_item_id je unique — omogućava
// idempotentan upsert i iz Event Bus pretplate i iz noćne rekonsilijacije).
model FactBooking {
  id                  String            @id @default(uuid())
  bookingItemId       String            @unique @map("booking_item_id") // weak ref → M5 BookingItem
  // `booking_id` je dopuna otkrivena pri implementaciji (van izvorne spec tabele §3.1) — bez nje
  // dinamički izveštaj (§4.2.1) ne bi mogao da spoji FactBooking sa FactPayment.booking_id (§3.2)
  // za paid/balance po čvoru, a da ostane samodovoljna projekcija bez live upita ka M5. Upisano i
  // u spec §3.1, isti princip kao FactPayment.payment_id ispod.
  bookingId           String            @map("booking_id") // weak ref → M5 Booking
  bookingDate         DateTime          @map("booking_date")
  stayFrom            DateTime          @map("stay_from")
  stayTo              DateTime          @map("stay_to")
  nights              Int
  guestCount          Int               @map("guest_count")
  productId           String            @map("product_id") // weak ref → M2 Product
  productType         ProductType       @map("product_type")
  accommodationType   String?           @map("accommodation_type") // samo product_type=ACCOMMODATION
  stars               Int?
  roomType            String?           @map("room_type") // samo CONTRACTED ACCOMMODATION stavke (M3 ContractPeriod.room_type)
  boardType           String?           @map("board_type") // samo CONTRACTED stavke (M3 RateLine.board_type)
  destinationCountry  String            @map("destination_country")
  destinationCity     String            @map("destination_city")
  sourceType          ProductSourceType @map("source_type")
  supplierId          String?           @map("supplier_id") // weak ref → M3 Supplier, kad CONTRACTED
  providerCode        String?           @map("provider_code") // weak ref → M4, kad API
  channel             String
  clientAccountId     String            @map("client_account_id") // weak ref → M6 ClientAccount
  baseCost            Int               @map("base_cost") // najmanja jedinica valute (M5 konvencija)
  finalPrice          Int               @map("final_price")
  currency            String
  margin              Int // izračunato: final_price - base_cost
  productName         String            @map("product_name") // snapshot naziva (M2 ProductTranslation)
  supplierName        String?           @map("supplier_name") // snapshot naziva dobavljača (M3), CONTRACTED
  subagentName        String?           @map("subagent_name") // snapshot naziva subagenta (M7); null = direktna prodaja
  // §4.3 dopuna (avgust 2026) — atribucija ka M12 sadržaju preko Booking.referral_tracking_code
  // vs. ContentPiece.tracking_code. M12 još ne postoji kao implementacija (samo spec) — ostaje
  // trajno null dok M12 ne dobije kod (spec §4.3 eksplicitno predviđa ovo kao normalan slučaj).
  referralContentId   String?           @map("referral_content_id") // weak ref → M12 ContentPiece
  referralContentName String?           @map("referral_content_name")
  status              BookingItemStatus
  lastSyncedAt        DateTime          @map("last_synced_at")

  @@map("fact_bookings")
}

// §3.2 `FactPayment` — za finansijske izveštaje (M10 Payment). `payment_id` je dopuna otkrivena
// pri implementaciji (van izvorne spec tabele od 5 kolona) — potreban je stabilan weak-ref ključ
// ka izvornom M10 Payment da bi upsert pri rekonsilijaciji/Event Bus sinhronizaciji bio
// idempotentan, isti princip kao FactBooking.booking_item_id; upisano i u spec §3.2.
model FactPayment {
  id         String   @id @default(uuid())
  paymentId  String   @unique @map("payment_id") // weak ref → M10 Payment
  bookingId  String   @map("booking_id") // weak ref → M5 Booking
  amountRsd  Int      @map("amount_rsd")
  method     String
  receivedAt DateTime @map("received_at")

  @@map("fact_payments")
}

// ============================================================================
// M12 — Marketing i sadržajni engine (docs/moduli/M12-marketing/15-SPECIFIKACIJA-M12-MARKETING.md)
// ============================================================================

enum ContentPieceType {
  BLOG_POST
  SOCIAL_POST
  EMAIL_NEWSLETTER
  BANNER
  STATIC_PAGE
}

enum ContentChannel {
  M8_SITE
  FACEBOOK
  INSTAGRAM
  EMAIL
  MOBILE_PUSH
}

// §3 — DRAFT je rezervisan isključivo za sadržaj koji ručno unosi čovek i još ga ne smatra
// spremnim za pregled; AI nacrt ulazi direktno u PENDING_APPROVAL (nema poseban ljudski korak
// koji bi ga prebacio iz DRAFT). APPROVED → PUBLISHED je nepovratna granica (approved_by).
enum ContentPieceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
}

enum ContentGeneratedBy {
  AI
  HUMAN
}

// §2.1 `ContentPiece`
model ContentPiece {
  id                       String             @id @default(uuid())
  productId                String?            @map("product_id") // weak ref → M2 Product; null za STATIC_PAGE i opšti BLOG_POST (§3b)
  type                     ContentPieceType
  slug                     String?            @unique // obavezno za STATIC_PAGE/BLOG_POST (§3b), nepotrebno za ostale tipove
  trackingCode             String             @unique @map("tracking_code") // auto-generisan, 8 karaktera, koristi se za atribuciju (§3a)
  targetChannels           ContentChannel[]   @map("target_channels")
  targetTags               Json?              @map("target_tags") // string[] — samo za EMAIL (§4); null/prazno = svi sa marketing_consent=true
  // §3c (YUTA preporuka avgust 2026) — true kad body/media sadrži SINTETIČKI AI-generisan
  // vizual (npr. DALL-E/Midjourney stil), za razliku od stvarne fotografije samo AI-*izvučene*
  // sa sajta dobavljača (M2 media.source=AI_IMPORTED, koja NE podleže ovom pravilu).
  containsAiGeneratedMedia Boolean            @default(false) @map("contains_ai_generated_media")
  scheduledPublishAt       DateTime?          @map("scheduled_publish_at") // kalendar = sort po ovom polju, bez posebnog entiteta
  status                   ContentPieceStatus @default(DRAFT)
  generatedBy              ContentGeneratedBy @map("generated_by")
  approvedBy               String?            @map("approved_by") // weak ref → M1 User; obavezno pre PUBLISHED, nikad AI
  publishedAt              DateTime?          @map("published_at")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  translations ContentTranslation[]
  media        ContentMedia[]

  @@map("content_pieces")
}

enum ContentMediaType {
  IMAGE
  VIDEO
}

// §2.5 `ContentMedia` (v1.x, 23.8.2026, na zahtev vlasnika — "kako dodajemo slike i reels?").
// `contains_ai_generated_media` (iznad) je oduvek bio SAMO oznaka/checkbox — nijedno polje nije
// stvarno čuvalo fajl. Isti obrazac kao M19 `MessageAttachment` (poglavlje 2.5 tog spec-a):
// lokalni disk API servera (`apps/api/uploads/marketing/`, van git-a) dok se hosting provajder za
// produkciju ne izabere (vlasnikova odluka preko `AskUserQuestion`, ista kao za M19 priloge).
// `mediaType` eksplicitno polje (ne izvedeno iz `mimeType` u letu na svakom čitanju) — jednostavnije
// za panel prikaz (galerija slika naspram video plejera) bez parsiranja MIME stringa na klijentu.
model ContentMedia {
  id             String           @id @default(uuid())
  contentPieceId String           @map("content_piece_id")
  mediaType      ContentMediaType @map("media_type")
  fileName       String           @map("file_name")
  mimeType       String           @map("mime_type")
  sizeBytes      Int              @map("size_bytes")
  storagePath    String           @map("storage_path")
  uploadedBy     String           @map("uploaded_by") // FK -> M1 User
  uploadedAt     DateTime         @default(now()) @map("uploaded_at")

  contentPiece ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)

  @@map("content_media")
}

// §2.2 `ContentTranslation` — isti obrazac kao M2 ProductTranslation (red po jeziku).
model ContentTranslation {
  id                String            @id @default(uuid())
  contentPieceId    String            @map("content_piece_id")
  languageCode      LanguageCode      @map("language_code")
  title             String
  body              String
  translationSource TranslationSource @default(MANUAL) @map("translation_source")
  isReviewed        Boolean           @default(false) @map("is_reviewed")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  contentPiece ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)

  @@unique([contentPieceId, languageCode])
  @@map("content_translations")
}

enum ChannelConfigStatus {
  ACTIVE
  INACTIVE
}

// §4 — konfiguracija distribucionih kanala, isti obrazac kao M4 ProviderConfig (kredencijali
// enkriptovano). M8_SITE i MOBILE_PUSH nemaju sopstveni adapter (§4) pa auth_config_encrypted
// ostaje null za njih — samo status/display_name su relevantni.
model ChannelConfig {
  id                  String              @id @default(uuid())
  channelCode         ContentChannel      @unique @map("channel_code")
  displayName         String              @map("display_name")
  authConfigEncrypted String?             @map("auth_config_encrypted")
  status              ChannelConfigStatus @default(INACTIVE)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@map("channel_configs")
}

// ============================================================================
// M16 — Agentski distribucioni interfejs (MCP)
// docs/moduli/M16-mcp-distribucija/17-SPECIFIKACIJA-M16-MCP-DISTRIBUCIJA.md §3.1
// ============================================================================

enum McpAccessLevel {
  READ_ONLY
  READ_WRITE
}

enum McpClientStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

// §3.1 — svaki registrovan spoljni MCP klijent (ChatGPT, Google, Sabre/MindTrip...).
// linkedUserId/linkedClientAccountId se popunjavaju pri prvom prelasku u ACTIVE (avgust 2026,
// implementaciona dopuna) — jedan AI_AGENT User + jedan LEGAL_ENTITY ClientAccount po klijentu,
// isti obrazac "sopstveni pool rezervacija" kao SUBAGENT_CONTACT (M7), ne GUEST po putniku.
model MCPClientRegistration {
  id                    String          @id @default(uuid())
  clientName            String          @map("client_name")
  // Heš (SHA-256, isti obrazac kao RefreshToken/PasswordResetToken — hashToken() u
  // secret-box.ts), ne reverzibilna enkripcija: server samo poredi predati Bearer token
  // sa ovim, nikad ne mora da ga ponovo pošalje spoljnoj strani. Naziv kolone prati spec §3.1.
  credentialsEncrypted  String          @unique @map("credentials_encrypted")
  accessLevel           McpAccessLevel  @default(READ_ONLY) @map("access_level")
  status                McpClientStatus @default(PENDING)
  rateLimitPerMinute    Int             @default(60) @map("rate_limit_per_minute")
  linkedUserId          String?         @map("linked_user_id")
  linkedClientAccountId String?         @map("linked_client_account_id")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  @@map("mcp_client_registrations")
}

// ============================================================================
// M9 — Mobilna aplikacija, poglavlje 3.2/3.3 (deo za vodiče na terenu, offline-first).
// Deo za goste (poglavlje 2) ne uvodi sopstvene modele — isti API-ji/entiteti kao M8/M5/M6.
// ============================================================================

// §3.3 `FieldIncidentNote.severity`
enum FieldIncidentSeverity {
  INFO
  WARNING
  URGENT
}

// §3.3 `FieldCheckIn` — vodič potvrđuje prisustvo gosta na polasku, upisano bez signala i
// sinhronizovano kasnije. `id` je KLIJENTSKI generisan UUID (aplikacija ga pravi pre slanja) i
// služi kao idempotency ključ za POST /mobile/staff/sync (§3.2 — "klijentski generisan
// idempotency_key po zapisu"), zato NEMA @default(uuid()) ovde.
model FieldCheckIn {
  id                 String    @id
  bookingItemGuestId String    @map("booking_item_guest_id") // FK -> M5 BookingItemGuest, weak reference (bez @relation, isti obrazac kao ostala cross-modul polja)
  checkedInAt        DateTime  @map("checked_in_at") // vreme na uređaju u trenutku radnje, ne vreme sinhronizacije
  checkedInBy        String    @map("checked_in_by") // FK -> M1 User (vodič), weak reference
  syncedAt           DateTime? @map("synced_at") // popunjava server pri prijemu (§3.2)

  @@map("field_check_ins")
}

// §3.3 `FieldIncidentNote` — beleška vodiča o incidentu na terenu; URGENT odmah generiše
// vidljivo upozorenje timu čim se sinhronizuje (§3.3, isti princip kao M10 neuspešno slanje
// fiskalnog dokumenta ka SEF/ESIR — vidi M9EventsService). `id` je klijentski generisan UUID,
// isti idempotency obrazac kao FieldCheckIn.
model FieldIncidentNote {
  id        String                @id
  bookingId String                @map("booking_id") // FK -> M5 Booking, weak reference
  guideId   String                @map("guide_id") // FK -> M1 User (vodič), weak reference
  note      String
  severity  FieldIncidentSeverity
  createdAt DateTime              @map("created_at") // vreme na uređaju
  syncedAt  DateTime?             @map("synced_at")

  @@map("field_incident_notes")
}

// ============================================================================
// M15 — AI agentska orkestracija (prvi prolaz, avgust 2026): docs/moduli/M15-ai-orkestracija/
// 18-SPECIFIKACIJA-M15-AI-ORKESTRACIJA.md. Ovaj prolaz implementira SAMO omnisearch (§6.5) za
// M17 kanal — modeli prate puni oblik iz §2.1/§3/§4 da bi budući prolazi (domenski agenti po
// modulu) mogli da dopune bez izmene šeme, ali se ovde seeduje samo ono što omnisearch koristi.
// ============================================================================

// §2.1 `AIAgent.agent_role` — treći enum vrednost OMNISEARCH_AGENT dodata u §6.5.1 (dopuna
// avgust 2026): poput GLAVNI_AGENT ima pristup preko granica modula, ali striktno samo za
// čitanje (nema CREATE/EDIT/SUBMIT/APPROVE ni u jednom M1 permission zapisu).
enum AgentRole {
  GLAVNI_AGENT
  DOMENSKI_AGENT
  OMNISEARCH_AGENT
  SUPPLIER_DRAFT_AGENT // M19 spec §9.5, dodato avgust 2026
  HELP_CENTER_AGENT // M21 spec §5.1, dodato avgust 2026
  EMAIL_INBOX_AGENT // M22 spec §4, dodato avgust 2026
  KNOWLEDGE_AGENT // M23 spec §3.2/§4, dodato avgust 2026
  BI_TERMINAL_AGENT // M15 spec §6.9, dodato avgust 2026 — isključivo read-only, isključivo Vlasnik
  WEB_CONTENT_SAFETY_AGENT // M15 spec §6.9.7, dodato 23.8.2026 — proverava sadržaj sa interneta PRE prikaza, nezavisan log od BiTerminalAgent-a
}

enum AgentStatus {
  ACTIVE
  DISABLED
}

// §2.1 model_tier — stabilna kategorija složenosti (dodato pri specifikaciji M18).
enum ModelTier {
  LIGHT
  STANDARD
  HEAVY
}

// §2.1 `AIAgent` — svaki AI agent je formalni M1 identitet (account_type = AI_AGENT).
model AIAgent {
  id              String      @id @default(uuid())
  userId          String      @unique @map("user_id") // FK -> M1 User, account_type = AI_AGENT
  agentRole       AgentRole   @map("agent_role")
  moduleCode      String?     @map("module_code") // null za GLAVNI_AGENT/OMNISEARCH_AGENT (koordinira preko svih)
  status          AgentStatus @default(DISABLED)
  modelTier       ModelTier?  @map("model_tier")
  modelIdentifier String?     @map("model_identifier")
  createdAt       DateTime    @default(now()) @map("created_at")

  // M18 spec §6.3/§6.5 — nazad-veze, dodato pri implementaciji M18.
  invocationLogs AgentInvocationLog[]
  budgets        AIAgentBudget[]

  @@map("ai_agents")
}

enum ModuleActivationStatus {
  NOT_READY
  READY_FOR_ACTIVATION
  ACTIVATED
}

// §3 `ModuleAgentActivation` — postepeno uvođenje, uvek ljudska odluka (activated_by).
// M15_OMNISEARCH je zaseban module_code, nezavisan od Faze 7 punog M15 okvira (§6.5 napomena).
model ModuleAgentActivation {
  moduleCode               String                 @id @map("module_code")
  testsPassing             Boolean                @default(false) @map("tests_passing")
  productionCycleCompleted Boolean                @default(false) @map("production_cycle_completed")
  status                   ModuleActivationStatus @default(NOT_READY)
  activatedBy              String?                @map("activated_by") // FK -> M1 User (Vlasnik/Direktor), nikad AI agent
  activatedAt              DateTime?              @map("activated_at")

  @@map("module_agent_activations")
}

enum AgentActionTier {
  NEVER_AUTONOMOUS
  PROPOSE_THEN_APPROVE
  AUTONOMOUS
}

// §4 `AgentActionType` — centralni registar akcija. Pun oblik tabele; ovaj prolaz seeduje samo
// omnisearch.query (globalno, AUTONOMOUS) — omnisearch.external_review_lookup je van obima
// (čeka whitelist odluku vlasnika, §6.5.6), ostale module-akcije iz spec §4 nisu seedovane ovde.
model AgentActionType {
  id         String          @id @default(uuid())
  moduleCode String?         @map("module_code") // null = "(globalno)" u spec tabeli §4
  actionCode String          @map("action_code")
  tier       AgentActionTier
  sourceNote String          @map("source_note") // "Izvor odluke" kolona iz §4
  createdAt  DateTime        @default(now()) @map("created_at")

  @@unique([moduleCode, actionCode])
  @@map("agent_action_types")
}

// ============================================================================
// M18 — Operativni nadzor i AI optimizacija: docs/moduli/M18-operativni-nadzor/
// 19-SPECIFIKACIJA-M18-OPERATIVNI-NADZOR.md. Read-only nad ostalim modulima (isti princip
// kao M13, spec §1). AIAgent.modelTier/modelIdentifier (iznad, M15 sekcija) su deo ovog
// modula po spec §6.1, već postoje u šemi otkad je M15 prvi prolaz implementiran.
// ============================================================================

enum HealthSignalType {
  PROVIDER_ERROR_SPIKE
  PAYMENT_FAILURE_SPIKE
  GUEST_REGISTRATION_FAILED
  FIELD_INCIDENT_URGENT
  AUTH_ANOMALY
  TOKEN_USAGE_ANOMALY
  RECONCILIATION_MISMATCH
  PROVIDER_DEGRADED
  LOW_CAPACITY_CRITICAL
  HELP_AGENT_ABUSE_PATTERN
  PAYMENT_DEADLINE_MISSED
}

enum HealthSignalSeverity {
  INFO
  WARNING
  CRITICAL
}

enum HealthSignalSecurityCategory {
  AUTH
  PII
  GDPR
  API_ABUSE
  ENCRYPTION
}

// §2.1 `HealthSignal` — jedan red po detektovanoj nepravilnosti. `sourceModule` je slobodan
// string (npr. "M4", "M10"), ne FK — isti princip kao M13 projekcija (nezavisna od izvora).
model HealthSignal {
  id               String                        @id @default(uuid())
  sourceModule     String                        @map("source_module")
  signalType       HealthSignalType              @map("signal_type")
  severity         HealthSignalSeverity
  securityCategory HealthSignalSecurityCategory? @map("security_category")
  details          Json
  detectedAt       DateTime                      @default(now()) @map("detected_at")
  notifiedAt       DateTime?                     @map("notified_at")

  @@map("health_signals")
}

enum NotificationChannelType {
  TELEGRAM
  EMAIL
  IN_APP
}

enum NotificationChannelStatus {
  ACTIVE
  INACTIVE
}

// §3 `NotificationChannel` — spoljni kanal dostave. `configEncrypted` isti obrazac kao
// `ProviderConfig.authConfigEncrypted` (M4) — AES-256-GCM preko common/crypto/secret-box.ts.
// IN_APP nema kredencijal (isporuka preko budućeg M19 API-ja) — polje ostaje prazan string.
model NotificationChannel {
  id              String                    @id @default(uuid())
  channelType     NotificationChannelType   @map("channel_type")
  configEncrypted String                    @map("config_encrypted")
  recipientRole   String                    @map("recipient_role")
  status          NotificationChannelStatus @default(ACTIVE)
  createdAt       DateTime                  @default(now()) @map("created_at")

  @@map("notification_channels")
}

enum ProviderHealthStatus {
  ONLINE
  UNSTABLE
  OFFLINE
}

// §2.3 `ProviderHealthSnapshot` — per-provajder metrika, izvedena periodičnim poslom iz
// M4 ProviderCallLog (poslednji prozor, poglavlje 2.3). providerCode nije FK (weak ref,
// isti princip kao M13 projekcija) — snapshot mora da preživi i provajdera koji je uklonjen.
model ProviderHealthSnapshot {
  id                 String               @id @default(uuid())
  providerCode       String               @map("provider_code")
  latencyMsAvg       Int                  @map("latency_ms_avg")
  uptimePercentage   Decimal              @map("uptime_percentage")
  errorCountLastHour Int                  @map("error_count_last_hour")
  status             ProviderHealthStatus
  computedAt         DateTime             @default(now()) @map("computed_at")

  @@map("provider_health_snapshots")
}

enum WeeklyHealthReviewStatus {
  GENERATED
  SENT
}

// §4.1 `WeeklyHealthReview` — nedeljni sažetak, uvek generisan i poslat (i "sve je u redu").
model WeeklyHealthReview {
  id              String                   @id @default(uuid())
  periodStart     DateTime                 @map("period_start") @db.Date
  periodEnd       DateTime                 @map("period_end") @db.Date
  summary         String
  signalsIncluded Json                     @map("signals_included")
  status          WeeklyHealthReviewStatus @default(GENERATED)
  generatedAt     DateTime                 @default(now()) @map("generated_at")
  sentAt          DateTime?                @map("sent_at")

  @@map("weekly_health_reviews")
}

enum TrendSuggestionCategory {
  AGENTSKI_TURIZAM
  PROIZVOD_UX
  TEHNOLOGIJA
}

enum TrendSuggestionStatus {
  DRAFT
  APPROVED
  REJECTED
}

// §5.1 `TrendSuggestion` — nikad automatski ne ulazi u Dodatak A Master dokumenta bez
// approved_by (ljudski uređivački korak van ovog sistema, spec §5, poglavlje "Tok").
model TrendSuggestion {
  id              String                  @id @default(uuid())
  category        TrendSuggestionCategory
  summary         String
  suggestedAction String                  @map("suggested_action")
  status          TrendSuggestionStatus   @default(DRAFT)
  approvedBy      String?                 @map("approved_by") // FK -> M1 User
  createdAt       DateTime                @default(now()) @map("created_at")

  @@map("trend_suggestions")
}

// §6.3 `AgentInvocationLog` — svaki stvaran poziv jezičkom modelu, bez obzira na agenta.
// Deterministički kod (provera roka/limita/datuma) NIKAD ne piše ovde (izlazni kriterijum §10) —
// odsustvo zapisa za action_code je dokaz, ne poseban flag.
model AgentInvocationLog {
  id               String    @id @default(uuid())
  agentId          String    @map("agent_id") // FK -> AIAgent
  actionCode       String    @map("action_code")
  modelTier        ModelTier @map("model_tier")
  modelIdentifier  String    @map("model_identifier")
  inputTokens      Int       @map("input_tokens")
  outputTokens     Int       @map("output_tokens")
  estimatedCostEur Decimal   @map("estimated_cost_eur")
  latencyMs        Int       @map("latency_ms")
  timestamp        DateTime  @default(now())

  agent AIAgent @relation(fields: [agentId], references: [id])

  @@map("agent_invocation_logs")
}

enum QuotaPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum EnforcementState {
  NORMAL
  DEGRADED
}

// §6.4/§6.5 `AIProviderQuota` — potrošnja po AI provajderu naspram ugovornog kvota
// (quota_limit/consumed, informativan alarm) I tvrdog EUR budžeta (budget_limit_eur/
// consumed_eur/enforcement_state, dopuna §6.5 — automatska degradacija na model_tier=LIGHT).
model AIProviderQuota {
  id                       String           @id @default(uuid())
  providerName             String           @map("provider_name")
  period                   QuotaPeriod
  // Ni quota_limit (ugovorni prag, tokeni) ni budget_limit_eur nisu pretpostavljeni ovde
  // (M18 spec §11 — "poslovna odluka vlasnika pri implementaciji") — oba nullable dok
  // Vlasnik/Direktor ne unese stvarnu vrednost preko PATCH /ai-provider-quota.
  quotaLimit               Int?             @map("quota_limit")
  consumed                 Int              @default(0)
  budgetLimitEur           Decimal?         @map("budget_limit_eur")
  consumedEur              Decimal          @default(0) @map("consumed_eur")
  enforcementState         EnforcementState @default(NORMAL) @map("enforcement_state")
  degradedAt               DateTime?        @map("degraded_at")
  periodStart              DateTime         @map("period_start") @db.Date
  periodEnd                DateTime         @map("period_end") @db.Date
  alertThresholdPercentage Int              @default(80) @map("alert_threshold_percentage")

  @@unique([providerName, period, periodStart])
  @@map("ai_provider_quotas")
}

// §6.5 `AIAgentBudget` — isti mehanizam, na nivou pojedinačnog agenta (jedan agent u petlji
// prelazi u sopstveni DEGRADED bez čekanja da cela potrošnja provajdera dostigne limit).
model AIAgentBudget {
  id               String           @id @default(uuid())
  agentId          String           @map("agent_id") // FK -> AIAgent
  period           QuotaPeriod
  budgetLimitEur   Decimal          @map("budget_limit_eur")
  consumedEur      Decimal          @default(0) @map("consumed_eur")
  enforcementState EnforcementState @default(NORMAL) @map("enforcement_state")
  periodStart      DateTime         @map("period_start") @db.Date
  periodEnd        DateTime         @map("period_end") @db.Date

  agent AIAgent @relation(fields: [agentId], references: [id])

  @@unique([agentId, period, periodStart])
  @@map("ai_agent_budgets")
}

// ============================================================================
// M19 — Komunikaciona platforma
// Izvor: docs/moduli/M19-komunikaciona-platforma/20-SPECIFIKACIJA-M19-KOMUNIKACIONA-PLATFORMA.md
// poglavlja 2, 9. Interni real-time tim-chat (DIRECT/GROUP, §2) + EXTERNAL_SUPPLIER razgovor sa
// SupplierContact portal nalogom (§9) — ista infrastruktura (Message/PresenceStatus), uža ograda
// po tipu razgovora (§9.3), ne paralelan sistem.
// ============================================================================

enum ConversationType {
  DIRECT
  GROUP
  EXTERNAL_SUPPLIER
}

// §2.1/§9.3 `Conversation`
model Conversation {
  id         String           @id @default(uuid())
  type       ConversationType
  name       String? // samo za GROUP
  createdBy  String           @map("created_by") // FK -> M1 User
  // §9.3 — popunjeno isključivo za EXTERNAL_SUPPLIER; plain UUID (weak ref ka M3 Supplier,
  // isti princip kao ProviderHealthSnapshot.providerCode — M19 ne uvozi M3 modul direktno).
  supplierId String?          @map("supplier_id")
  createdAt  DateTime         @default(now()) @map("created_at")

  participants         ConversationParticipant[]
  messages             Message[]
  supplierAccessGrants SupplierConversationAccess[]

  @@map("conversations")
}

// §2.2/§9.3 `ConversationParticipant` — DIRECT/GROUP: isključivo account_type=STAFF;
// EXTERNAL_SUPPLIER: STAFF (uz SupplierConversationAccess, §9.4) + tačno jedan SUPPLIER_CONTACT.
// Sprovedeno na nivou aplikacije (ConversationsService), ne DB constraint-om (isti stil kao ostali
// moduli — CLAUDE.md: "nema koda bez oslonca u specifikaciji" ne znači "svaka provera je u šemi").
model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id") // FK -> M1 User
  joinedAt       DateTime  @default(now()) @map("joined_at")
  lastReadAt     DateTime? @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

// §2.3 `Message` — meko brisanje (deletedAt), ne fizičko.
model Message {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id") // FK -> M1 User
  // Nullable od v1.6 (§2.5) — poruka može biti ČIST prilog bez teksta (npr. samo slika/PDF).
  // Servis i dalje odbija poruku bez i teksta i priloga (bar jedno mora postojati).
  body           String?
  sentAt         DateTime  @default(now()) @map("sent_at")
  editedAt       DateTime? @map("edited_at")
  deletedAt      DateTime? @map("deleted_at")
  // M19 spec §2.3/§9.5 — evidencija AI porekla teksta. NE menja senderId: odgovornost za poruku
  // nosi čovek koji je pritisnuo "pošalji". Upisuje se u trenutku slanja jer AI nacrt nikad ne
  // postaje Message sam po sebi (SupplierDraftService vraća samo tekst) — drugog trenutka nema.
  draftedByAi      Boolean @default(false) @map("drafted_by_ai")
  draftedByAgentId String? @map("drafted_by_agent_id") // FK -> M1 User, accountType = AI_AGENT

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@map("messages")
}

// §2.5 `MessageAttachment` (v1.6, avgust 2026, na zahtev vlasnika — "omogućite u chatovima i
// porukama da se šalju i preuzimaju fajlovi") — jedan ili više priloga po poruci. `storagePath`
// pokazuje na LOKALNI disk API servera (`apps/api/uploads/chat/`, van git-a) — vlasnikova
// eksplicitna odluka (preko AskUserQuestion) dok se hosting provajder za produkciju ne izabere
// (CLAUDE.md/docker-compose.yml — namerno neizabran). Kad se hosting izabere, ovo polje svesno
// prelazi na pravi object storage (S3-kompatibilan) — ista napomena kao i sam hosting, ne
// propust. Fajl se NIKAD ne servira kao statički javan resurs — isključivo kroz autentifikovan
// `GET /chat/attachments/:id` koji proverava učešće pozivaoca u razgovoru kom poruka pripada
// (isti `assertParticipant` kao ostatak modula), da prilog ne postane dostupan van kruga učesnika.
model MessageAttachment {
  id          String   @id @default(uuid())
  messageId   String   @map("message_id")
  fileName    String   @map("file_name") // originalno ime koje je pošiljalac poslao
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  storagePath String   @map("storage_path")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

enum PresenceStatusValue {
  ONLINE
  AWAY
  OFFLINE
}

// §2.4 `PresenceStatus` — "kuca poruku..." je efemeran WS signal, ne perzistira se ovde (§2.4 napomena).
model PresenceStatus {
  userId     String              @id @map("user_id") // FK -> M1 User, unique
  status     PresenceStatusValue @default(OFFLINE)
  lastSeenAt DateTime            @default(now()) @map("last_seen_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@map("presence_statuses")
}

// §9.4 `SupplierConversationAccess` — isti dvoslojni obrazac kao M22 MailboxAccess: opšta
// M19/supplier-conversation/VIEW dozvola određuje DA LI tip pristupa uopšte postoji za tu ulogu,
// ovaj red određuje KOJI konkretan EXTERNAL_SUPPLIER razgovor.
model SupplierConversationAccess {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id") // FK -> Conversation, type=EXTERNAL_SUPPLIER
  userId         String   @map("user_id") // FK -> M1 User, account_type=STAFF
  grantedBy      String   @map("granted_by") // FK -> M1 User
  grantedAt      DateTime @default(now()) @map("granted_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("supplier_conversation_accesses")
}

// ============================================================================
// M21 — Centar za pomoć (baza znanja + AI asistent)
// Izvor: docs/moduli/M21-centar-za-pomoc/23-SPECIFIKACIJA-M21-CENTAR-ZA-POMOC.md
// poglavlje 2. Prvi prolaz implementacije (avgust 2026) — tri publike (STAFF/SUBAGENT/
// BUSINESS_CLIENT), AI asistent ograđen isključivo na PUBLISHED sadržaj (§5.2), eskalacija
// ka M14 (§5.3, weak-ref escalated_ticket_id — isti obrazac kao ostale cross-modularne
// slabe reference u repou, npr. Ticket.related_booking_id).
// ============================================================================

// PUBLIC_GUEST dodato avgust 2026 (vlasnikova odluka — M15 spec §11 "B2C_SITE omnisearch
// dopuna") — pokriva I anonimnog B2C posetioca (bez naloga) I prijavljenog GUEST naloga čiji
// je povezani ClientAccount.account_type=INDIVIDUAL (M21 spec §1 je već objasnio zašto je
// INDIVIDUAL isključen iz v1; ista logika sad daje toj publici sopstveni uži skup članaka
// umesto potpunog isključenja).
enum HelpAudience {
  STAFF
  SUBAGENT
  BUSINESS_CLIENT
  PUBLIC_GUEST
}

enum HelpArticleStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
}

// §2.1 `HelpArticle` — jedan članak baze znanja. `generatedBy` reupotrebljava M12
// `ContentGeneratedBy` (AI/HUMAN) — identičan skup vrednosti, nema razloga za paralelan enum.
model HelpArticle {
  id                String             @id @default(uuid())
  slug              String             @unique
  audience          HelpAudience[]     @map("audience") // native Postgres niz, isti obrazac kao M12 ContentPiece.targetChannels
  relatedModule     String?            @map("related_module") // npr. "M5", "M10" — filtriranje/pretraga
  isCriticalExample Boolean            @default(false) @map("is_critical_example") // §4 — korak-po-korak radni scenario, prioritet u odgovorima agenta
  status            HelpArticleStatus  @default(DRAFT)
  generatedBy       ContentGeneratedBy @map("generated_by")
  approvedBy        String?            @map("approved_by") // weak ref → M1 User; obavezno pre PUBLISHED, nikad AI (§2.1)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  publishedAt       DateTime?          @map("published_at")

  translations HelpArticleTranslation[]

  @@map("help_articles")
}

// §2.2 `HelpArticleTranslation` — isti obrazac kao M2 ProductTranslation/M12 ContentTranslation
// (red po jeziku, isti LanguageCode enum, isti fallback traženi→en→sr).
model HelpArticleTranslation {
  id            String       @id @default(uuid())
  helpArticleId String       @map("help_article_id")
  languageCode  LanguageCode @map("language_code")
  title         String
  body          String // markdown; za is_critical_example=true numerisana lista koraka, obična markdown lista
  // M21 spec §5.2a — semantička pretraga (pgvector, OpenAI text-embedding-3-small, 1536 dim).
  // Prisma nema izvornu podršku za `vector` tip — čita/piše se isključivo preko $queryRaw/
  // $executeRaw (HelpAssistantService), NULL dok se lenjo ne izračuna pri prvom ask() pozivu
  // koji naiđe na tu stavku (nema eager backfill pri objavi u ovom prolazu).
  embedding Unsupported("vector(1536)")?

  helpArticle HelpArticle @relation(fields: [helpArticleId], references: [id], onDelete: Cascade)

  @@unique([helpArticleId, languageCode])
  @@map("help_article_translations")
}

// Odvojen enum od HelpAudience iako ima iste vrednosti — nema pisanog traga (ni u spec-u ni u
// komentaru uz originalni v1 upis) da li je razdvajanje bilo namerno (HelpArticle.audience je
// niz — više publika po članku; HelpQuestion.audienceContext je uvek tačno jedna vrednost po
// pitanju, pa bi spajanje u zajednički enum načelno bilo bezbedno) ili slučajno. Ova dopuna
// (avgust 2026, PUBLIC_GUEST) svesno NE spaja ta dva enuma — manja, sigurnija izmena; ako se
// pokaže da je razdvajanje zaista bilo slučajno, spajanje ostaje otvorena stavka za budući prolaz.
enum HelpAudienceContext {
  STAFF
  SUBAGENT
  BUSINESS_CLIENT
  PUBLIC_GUEST
}

enum HelpConfidence {
  HIGH
  LOW
  NONE
}

// §2.3 `HelpQuestion` — svako pitanje postavljeno AI asistentu (log). escalated_ticket_id je
// weak ref → M14 Ticket (isti princip kao Ticket.related_booking_id — cross-modularne veze
// ne dobijaju hard FK, poglavlje 3 princip #2 CLAUDE.md).
model HelpQuestion {
  id                String              @id @default(uuid())
  askedBy           String?             @map("asked_by") // weak ref → M1 User; NULL = potpuno anoniman B2C posetilac (avgust 2026, PUBLIC_GUEST) — logovani INDIVIDUAL gost i dalje ima stvaran userId ovde
  audienceContext   HelpAudienceContext @map("audience_context")
  questionText      String              @map("question_text")
  answerText        String?             @map("answer_text")
  matchedArticleIds String[]            @map("matched_article_ids")
  confidence        HelpConfidence
  wasHelpful        Boolean?            @map("was_helpful")
  escalatedTicketId String?             @map("escalated_ticket_id") // weak ref → M14 Ticket
  createdAt         DateTime            @default(now()) @map("created_at")

  @@map("help_questions")
}

enum HelpArticleSuggestionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// §2.4 `HelpArticleSuggestion` — predlog novog članka iz stvarne upotrebe (§5.4 — ponovljena
// NONE/LOW pitanja na istu temu). APPROVED kreira stvaran HelpArticle(status=PENDING_APPROVAL),
// koji i dalje čeka sopstveni korak objavljivanja (dva odvojena koraka odobrenja).
model HelpArticleSuggestion {
  id                 String                      @id @default(uuid())
  basedOnQuestionIds String[]                    @map("based_on_question_ids")
  draftTitle         String                      @map("draft_title")
  draftBody          String                      @map("draft_body")
  status             HelpArticleSuggestionStatus @default(DRAFT)
  reviewedBy         String?                     @map("reviewed_by") // weak ref → M1 User
  createdAt          DateTime                    @default(now()) @map("created_at")
  reviewedAt         DateTime?                   @map("reviewed_at")

  @@map("help_article_suggestions")
}

// ============================================================================
// M22 — Email/Inbox platforma
// Izvor: docs/moduli/M22-email-inbox/25-SPECIFIKACIJA-M22-EMAIL-INBOX.md poglavlje 2.
// Prvi prolaz implementacije (avgust 2026) — generički EmailProviderAdapter (isti obrazac
// kao M4 ProviderAdapter) sa mock implementacijom, eksplicitna pojedinačna dodela pristupa
// po sandučetu (MailboxAccess, ne opšta uloga), AI sažetak/nacrt na svaku INBOUND poruku
// (§4), i poklapanje po referentnom kodu za jedinstveno sanduče dobavljača (§3.1a, M5 §8.8).
// ============================================================================

enum MailboxType {
  SHARED
  PERSONAL
}

enum MailboxStatus {
  ACTIVE
  INACTIVE
}

// §2.1 `Mailbox`. `isSupplierUnifiedInbox` — pojednostavljenje pri implementaciji (dokumentovano
// u M22 spec §10): M5 §8.8 traži "tačno jedan Mailbox koji pokriva svaku komunikaciju ka
// dobavljačima", sistemska konfiguracija, ne po dobavljaču/timu. Umesto posebnog konfiguracionog
// modela za jedan red, obeleženo je direktno na Mailbox-u ovim boolean poljem — servisni sloj
// (MailboxesService.create) garantuje najviše jedan `true` red u isto vreme (nema DB constraint
// za "najviše jedan true" u Postgres bez parcijalnog unique indeksa, koji nije uveden u ovom
// prolazu — dovoljno za obim v1, jasno mesto za pooštravanje ako zatreba).
model Mailbox {
  id                    String        @id @default(uuid())
  address               String        @unique
  displayName           String        @map("display_name")
  mailboxType           MailboxType   @map("mailbox_type")
  ownerUserId           String?       @map("owner_user_id") // FK -> M1 User, samo za PERSONAL
  providerConnectionRef String        @map("provider_connection_ref") // isti princip kao M4 ProviderConfig.authConfigEncrypted
  isSupplierUnifiedInbox Boolean      @default(false) @map("is_supplier_unified_inbox") // M5 §8.8
  status                MailboxStatus @default(ACTIVE)
  createdAt             DateTime      @default(now()) @map("created_at")

  access  MailboxAccess[]
  threads EmailThread[]

  @@map("mailboxes")
}

enum MailboxAccessLevel {
  VIEW
  REPLY
}

// §2.2 `MailboxAccess` — pristup se NIKAD ne izvodi iz opšte M1 uloge, isti dvoslojni obrazac
// kao M19 SupplierConversationAccess. Vlasnik PERSONAL sandučeta dobija REPLY automatski
// (MailboxesService.create), upisano servisnim slojem, ne DB trigerom.
model MailboxAccess {
  id          String             @id @default(uuid())
  mailboxId   String             @map("mailbox_id")
  userId      String             @map("user_id") // FK -> M1 User
  accessLevel MailboxAccessLevel @map("access_level")
  grantedBy   String             @map("granted_by") // FK -> M1 User
  grantedAt   DateTime           @default(now()) @map("granted_at")

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, userId])
  @@map("mailbox_access")
}

enum EmailCorrespondentType {
  GUEST
  SUBAGENT
  SUPPLIER
  OTHER
}

enum EmailThreadStatus {
  OPEN
  AWAITING_REPLY
  CLOSED
}

// §2.3 `EmailThread`. correspondent_* i related_* polja su weak-ref (plain String, bez Prisma
// @relation) — isti obrazac kao ostali cross-modularni pokazivači u repou (npr. Ticket.
// related_booking_id, HelpQuestion.escalated_ticket_id) — M22 ne pravi hard DB constraint
// preko granice modula (princip #2 Master dokumenta).
model EmailThread {
  id                             String                  @id @default(uuid())
  mailboxId                      String                  @map("mailbox_id")
  subject                        String
  correspondentType              EmailCorrespondentType  @default(OTHER) @map("correspondent_type")
  correspondentClientAccountId   String?                 @map("correspondent_client_account_id") // weak ref -> M6 ClientAccount
  correspondentSupplierId        String?                 @map("correspondent_supplier_id") // weak ref -> M3 Supplier
  relatedBookingId               String?                 @map("related_booking_id") // weak ref -> M5 Booking
  relatedSupplierManifestId      String?                 @map("related_supplier_manifest_id") // weak ref -> M5 SupplierManifest (§3.1a)
  relatedSupplierChangeNoticeId  String?                 @map("related_supplier_change_notice_id") // weak ref -> M5 SupplierChangeNotice (§3.1a)
  status                         EmailThreadStatus       @default(OPEN)
  convertedToTicketId            String?                 @map("converted_to_ticket_id") // weak ref -> M14 Ticket
  lastMessageAt                  DateTime                @default(now()) @map("last_message_at")
  createdAt                      DateTime                @default(now()) @map("created_at")

  mailbox  Mailbox        @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  messages EmailMessage[]

  @@map("email_threads")
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailSenderType {
  CORRESPONDENT
  STAFF
  AI_DRAFT
}

// §2.4 `EmailMessage`. `sentBy` popunjeno kad je STAFF/AI_DRAFT poruka stvarno poslata — isti
// mehanizam kao M14 TicketMessage.sent_by (AI_DRAFT nikad dobija sent_by pri kreiranju).
model EmailMessage {
  id                String          @id @default(uuid())
  threadId          String          @map("thread_id")
  direction         EmailDirection
  senderType        EmailSenderType @map("sender_type")
  fromAddress       String          @map("from_address")
  toAddresses       String[]        @map("to_addresses")
  body              String
  aiSummary         String?         @map("ai_summary")
  sentBy            String?         @map("sent_by") // FK -> M1 User
  providerMessageId String?         @unique @map("provider_message_id") // Message-ID header — threading/idempotentnost pri ponovnom uvozu
  receivedAt        DateTime        @default(now()) @map("received_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("email_messages")
}

// ============================================================================
// M23 — Znanje
// Izvor: docs/moduli/M23-znanje/28-SPECIFIKACIJA-M23-ZNANJE.md poglavlje 2.
// Model podataka namerno prati M21 (Article/ArticleTranslation/Question ~ HelpArticle/
// HelpArticleTranslation/HelpQuestion) — razlika je u izvoru sadržaja (poglavlje 4,
// ArticleSource/ArticleRevision su NOVI u odnosu na M21) i u tome što M23 nema `audience`
// polje (§3.1 — ista publika za interni tim i subagente, za razliku od M21).
// ============================================================================

enum ArticleSubjectType {
  PRODUCT
  DESTINATION
  COUNTRY
}

enum ArticleStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
}

// §2.1 `Article` — jedan članak baze znanja. generatedBy reupotrebljava M21/M12
// ContentGeneratedBy (AI/HUMAN) — identičan skup vrednosti.
model Article {
  id                 String             @id @default(uuid())
  subjectType        ArticleSubjectType @map("subject_type")
  productId          String?            @map("product_id") // weak ref -> M2 Product, samo za subject_type=PRODUCT (poglavlje 3, princip #2 — nema hard FK preko modula)
  destinationCountry String?            @map("destination_country")
  destinationCity    String?            @map("destination_city") // prazno za subject_type=COUNTRY
  status             ArticleStatus      @default(DRAFT)
  generatedBy        ContentGeneratedBy @map("generated_by")
  approvedBy         String?            @map("approved_by") // weak ref -> M1 User; obavezno pre PUBLISHED, nikad AI (§2.1/§9)
  shareToken         String?            @unique @map("share_token") // generiše se pri prvom prelasku u PUBLISHED (poglavlje 5)
  lastRefreshedAt    DateTime?          @map("last_refreshed_at")
  nextRefreshDueAt   DateTime?          @map("next_refresh_due_at") // last_refreshed_at + 30 dana, izračunato u servisu (poglavlje 4c)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  publishedAt        DateTime?          @map("published_at")

  translations ArticleTranslation[]
  sources      ArticleSource[]
  revisions    ArticleRevision[]

  @@map("articles")
}

enum ArticleTranslationSource {
  MANUAL
  AI_GENERATED
}

// §2.2 `ArticleTranslation` — isti obrazac kao M21 HelpArticleTranslation (isti LanguageCode
// enum, isti fallback traženi->en->sr).
model ArticleTranslation {
  id                String                   @id @default(uuid())
  articleId         String                   @map("article_id")
  languageCode      LanguageCode             @map("language_code")
  title             String
  body              String // markdown
  translationSource ArticleTranslationSource @default(MANUAL) @map("translation_source")
  // M23 spec §3.2a — semantička pretraga, isti mehanizam/model kao HelpArticleTranslation
  // (M21 spec §5.2a) — vidi komentar tamo.
  embedding Unsupported("vector(1536)")?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, languageCode])
  @@map("article_translations")
}

// §2.3/§4a — jedini dozvoljeni tipovi izvora, sprovedeno na nivou enuma (nema OTHER/OTA/
// REVIEW_SITE vrednosti da se izabere).
enum ArticleSourceType {
  HOTEL_OFFICIAL_WEBSITE
  HOTEL_SOCIAL_MEDIA
  GOVERNMENT_OR_TOURISM_BOARD
}

enum ArticleSourceStatus {
  CANDIDATE
  APPROVED
  REJECTED
}

// §2.3 `ArticleSource` — odobren izvor korišćen za sadržaj (poglavlje 4b — CANDIDATE dok čovek
// eksplicitno ne odobri).
model ArticleSource {
  id         String               @id @default(uuid())
  articleId  String               @map("article_id")
  url        String
  sourceType ArticleSourceType    @map("source_type")
  status     ArticleSourceStatus  @default(CANDIDATE)
  approvedBy String?              @map("approved_by") // weak ref -> M1 User, nikad AI (§4b)
  approvedAt DateTime?            @map("approved_at")
  createdAt  DateTime             @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_sources")
}

enum ArticleRevisionTrigger {
  INITIAL_CREATION
  SCHEDULED_REFRESH
  QUESTION_GAP
}

enum ArticleRevisionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// §2.4 `ArticleRevision` — predložena izmena (početna izrada ili 30-dnevno osvežavanje).
// Odobrenje upisuje proposed_translations kao stvarne ArticleTranslation redove (zamenjuje
// postojeće po jeziku), postavlja Article.last_refreshed_at=now() i ponovo računa
// next_refresh_due_at. Odbijanje ne menja ništa na Article (poglavlje 2.4/4c).
model ArticleRevision {
  id                   String                 @id @default(uuid())
  articleId            String                 @map("article_id")
  trigger              ArticleRevisionTrigger
  proposedTranslations Json                    @map("proposed_translations") // nacrt po jeziku, isti oblik kao ArticleTranslation
  sourceIds            String[]               @map("source_ids") // FK niz -> ArticleSource, svi moraju biti APPROVED — validacija u servisu, ne DB constraint
  status               ArticleRevisionStatus  @default(PENDING_REVIEW)
  reviewedBy           String?                @map("reviewed_by") // weak ref -> M1 User, nikad AI
  reviewedAt           DateTime?              @map("reviewed_at")
  createdAt            DateTime               @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_revisions")
}

enum ArticleConfidence {
  HIGH
  LOW
  NONE
}

// §2.5 `Question` — svako pitanje postavljeno AI agentu (log), isti obrazac kao M21 HelpQuestion.
// triggeredRevisionId je weak ref (isti princip kao HelpQuestion.escalatedTicketId).
model Question {
  id                  String            @id @default(uuid())
  askedBy             String            @map("asked_by") // FK -> M1 User
  questionText        String            @map("question_text")
  answerText          String?           @map("answer_text")
  matchedArticleIds   String[]          @map("matched_article_ids")
  confidence          ArticleConfidence
  wasHelpful          Boolean?          @map("was_helpful")
  triggeredRevisionId String?           @map("triggered_revision_id") // weak ref -> ArticleRevision (trigger=QUESTION_GAP)
  createdAt           DateTime          @default(now()) @map("created_at")

  @@map("questions")
}
