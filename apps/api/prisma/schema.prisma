  guestProfileId  String?                @map("guest_profile_id")
  channel         CommunicationChannel
  direction       CommunicationDirection
  summary         String
  draftedByAi     Boolean                @default(false) @map("drafted_by_ai")
  sentBy          String?                @map("sent_by")
  createdAt       DateTime               @default(now()) @map("created_at")

  @@map("communication_logs")
}

enum PostTripSurveyStatus {
  PENDING
  SENT
  COMPLETED
}

// §4.3 `PostTripSurvey`. client_account_id NAMERNO bez FK — isti razlog kao ClientLoyaltyStatus
// iznad (kopira se direktno iz Booking.client_account_id, koji nema DB-nivo FK).
model PostTripSurvey {
  id                    String               @id @default(uuid())
  bookingId             String               @unique @map("booking_id")
  clientAccountId       String               @map("client_account_id")
