// §8.1 `SupplierObligation`
model SupplierObligation {
  id                              String                   @id @default(uuid())
  supplierId                      String                   @map("supplier_id")
  bookingItemId                   String?                  @map("booking_item_id") // obavezno pre prelaska u APPROVED (§8.3)
  invoiceReference                String?                  @map("invoice_reference")
  amountOriginal                  Int                      @map("amount_original")
  currencyOriginal                String                   @map("currency_original")
  exchangeRateSnapshotIdAtInvoice String?                  @map("exchange_rate_snapshot_id_at_invoice")
  amountRsdAtInvoice              Int?                     @map("amount_rsd_at_invoice")
  dueDate                         DateTime                 @map("due_date")
  status                          SupplierObligationStatus @default(PENDING)
  paymentMethod                   SupplierPaymentMethod    @default(BANK_TRANSFER) @map("payment_method") // §8.5.1
  paidAt                          DateTime?                @map("paid_at")
  exchangeRateSnapshotIdAtPayment String?                  @map("exchange_rate_snapshot_id_at_payment")
  exchangeRateDifference          Int?                     @map("exchange_rate_difference")
  createdAt                       DateTime                 @default(now()) @map("created_at")
  updatedAt                       DateTime                 @updatedAt @map("updated_at")

  supplier              Supplier                     @relation(fields: [supplierId], references: [id])
  bookingItem           BookingItem?                 @relation(fields: [bookingItemId], references: [id])
  exchangeRateAtInvoice ExchangeRateSnapshot?        @relation("ObligationInvoiceRate", fields: [exchangeRateSnapshotIdAtInvoice], references: [id])
  exchangeRateAtPayment ExchangeRateSnapshot?        @relation("ObligationPaymentRate", fields: [exchangeRateSnapshotIdAtPayment], references: [id])
  paymentInstructions   SupplierPaymentInstruction[]
  importedRows          SupplierInvoiceImportRow[]

  @@map("supplier_obligations")
}

enum SupplierPaymentInstructionStatus {
  PENDING
  EXECUTED
  FAILED
}

// §8.5.2 `SupplierPaymentInstruction`
model SupplierPaymentInstruction {
  id                   String                           @id @default(uuid())
  supplierObligationId String                           @map("supplier_obligation_id")
  method               SupplierPaymentMethod
  bankIban             String?                          @map("bank_iban") // samo za BANK_TRANSFER
  bankSwift            String?                          @map("bank_swift") // samo za BANK_TRANSFER
  virtualCardReference String?                          @map("virtual_card_reference") // samo za VIRTUAL_CARD — nikad pun broj kartice
  status               SupplierPaymentInstructionStatus @default(PENDING)
  executedBy           String?                          @map("executed_by") // obavezno ljudski nalog pri EXECUTED — nikad AI
  executedAt           DateTime?                        @map("executed_at")
  createdAt            DateTime                         @default(now()) @map("created_at")

  supplierObligation SupplierObligation @relation(fields: [supplierObligationId], references: [id])

  @@map("supplier_payment_instructions")
