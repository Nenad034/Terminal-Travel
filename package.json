{
  "name": "terminal",
  "private": true,
  "description": "Terminal — poslovna platforma agencije Terminal Travel (TT). Monorepo: apps/api (NestJS) prati module iz docs/moduli/, jedan po jedan po faznom planu (docs/00-MASTER-ARHITEKTURA.md, poglavlje 8).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/api",
    "dev": "npm run start:dev --workspace=apps/api",
    "test": "npm run test --workspace=apps/api",
    "test:e2e": "npm run test:e2e --workspace=apps/api",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "prisma:seed": "npm run prisma:seed --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web"
  },
  "engines": {
    "node": ">=20"
  }
}
